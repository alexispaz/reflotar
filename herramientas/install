#!/usr/bin/env python3
"""install - copy the fleet tools into /home/agents, for the claude user to run.

  ./install          show the plan; change nothing (default)
  ./install --go     do it

Run by the human, as the human, from their OWN clone of this repository,
after the planner (sistema/plan-agentes.py), which installs the fleet.toml it reads. No root:
/home/agents belongs to the human. It replaces upstream's install, which linked the tools into the ~/bin of
whoever ran it. Here the tools run as claude and the clone lives in a home claude
cannot read, so they are COPIED, and the agents can run them but not change them.

  <prefix>/lib/fleet/       the `fleet` package and the selected tools (human:agents)
  <prefix>/bin/<tool>       a wrapper per selected tool, on every agent's PATH
                            (human:agents: claude and codex run it, the
                            pensadero does not; you must be in `agents`)

The wrapper fixes FLEET_CONFIG to <prefix>/etc/fleet, where the planner installs
fleet.toml, so a tool reads the human's limits and not a copy an agent could edit.
Which tools: [install] tools in that installed fleet.toml. Each repository installs
its own: this one the code, the planner the configuration. A tool dropped from the list has its copy and wrapper removed. Skills
are not installed yet; a non-empty [install] skills is refused.

It refuses to run when a source, or a folder above it up to its clone, is a
symlink or belongs to someone other than the user running it: what it copies is
then what that user reviewed. The code was reviewed in git before merging; --diff
shows it again as it changes.

--prefix DIR installs somewhere else (the tests use it). --config FILE reads the
tool list from elsewhere (default: <prefix>/etc/fleet/fleet.toml).
"""
import argparse, difflib, grp, os, stat, sys, tempfile, tomllib

APP = os.path.dirname(os.path.realpath(__file__))
WRAPPER_MARK = "# fleet wrapper, written by fleet/install"
CODE_GROUP, CONFIG_GROUP = "agents", "buzon"   # agents: claude and codex, not the pensadero


def check_source(path, root):
    """path and every folder above it, up to root, belong to us and are not symlinks."""
    me, p = os.getuid(), path
    while True:
        st = os.lstat(p)
        if stat.S_ISLNK(st.st_mode) or st.st_uid != me:
            why = "a symlink" if stat.S_ISLNK(st.st_mode) else f"owned by uid {st.st_uid}"
            sys.exit(f"install: refusing to run: {p} is {why}. Run it from YOUR clone "
                     "(git fetch from the agent's copy, review, merge).")
        if p == root or p == os.path.dirname(p):
            return
        p = os.path.dirname(p)


def wrapper(lib, etc, tool):
    return (f"#!/bin/sh\n{WRAPPER_MARK}\n"
            f"FLEET_CONFIG={etc}; export FLEET_CONFIG\n"
            "PYTHONDONTWRITEBYTECODE=1; export PYTHONDONTWRITEBYTECODE\n"
            f'exec {lib}/bin/{tool} "$@"\n')     # its own #! line: not every tool is python


class Plan:
    def __init__(self, go, groups, code_diffs):
        self.go, self.groups, self.code_diffs = go, groups, code_diffs
        self.actions, self.diffs = [], []

    def say(self, what, path):
        self.actions.append(f"  {what:<9} {path}")

    def gid(self, group):
        return grp.getgrnam(self.groups.get(group, group)).gr_gid

    def fix(self, path, group, mode):
        os.chown(path, -1, self.gid(group))
        os.chmod(path, mode)

    def owned(self, path, group, mode):
        st = os.stat(path)
        if st.st_gid != self.gid(group) or stat.S_IMODE(st.st_mode) != mode:
            self.say("chmod", f"{path}  ({group}, {mode:o})")
            if self.go:
                self.fix(path, group, mode)

    def directory(self, path, group, mode):
        if os.path.isdir(path):
            self.owned(path, group, mode)
            return
        self.say("mkdir", f"{path}  ({group}, {mode:o})")
        if self.go:
            os.makedirs(path, exist_ok=True)
            self.fix(path, group, mode)

    def file(self, dst, text=None, src=None, group=CODE_GROUP, mode=0o640):
        """Put text (or src's contents) at dst, atomically, when it differs."""
        if text is None:
            with open(src) as f:
                text = f.read()
        old = None
        if os.path.exists(dst):
            with open(dst) as f:
                old = f.read()
        if old == text:
            self.owned(dst, group, mode)
            return
        self.say("install" if old is None else "update", dst)
        if self.code_diffs:
            self.diffs.append("".join(difflib.unified_diff(
                (old or "").splitlines(True), text.splitlines(True), dst, src or "(generated)")))
        if self.go:
            fd, tmp = tempfile.mkstemp(dir=os.path.dirname(dst), prefix="install-tmp-")
            with os.fdopen(fd, "w") as f:
                f.write(text)
            self.fix(tmp, group, mode)
            os.replace(tmp, dst)

    def remove(self, path, why):
        self.say("remove", f"{path}  ({why})")
        if self.go:
            os.remove(path)


def listing(path):
    return sorted(os.listdir(path)) if os.path.isdir(path) else []


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--go", action="store_true", help="do it (default: show the plan)")
    ap.add_argument("--diff", action="store_true", help="also show the code that changes")
    ap.add_argument("--prefix", default="/home/agents")
    ap.add_argument("--config", default=None)
    ap.add_argument("--groups", default="", help=argparse.SUPPRESS)   # tests: claude=x,buzon=y
    args = ap.parse_args(argv)
    groups = dict(kv.split("=", 1) for kv in args.groups.split(",") if kv)

    installed = args.config is None
    if installed:
        args.config = os.path.join(args.prefix, "etc", "fleet", "fleet.toml")
    if not os.path.isfile(args.config):
        sys.exit(f"install: no {args.config}"
                 + (" (run the planner first: it installs fleet.toml)" if installed else ""))
    check_source(os.path.abspath(args.config),
                 os.path.abspath(args.prefix) if installed else os.path.dirname(os.path.abspath(args.config)))
    with open(args.config, "rb") as f:
        sel = tomllib.load(f).get("install", {})
    tools = list(sel.get("tools", []))
    if sel.get("skills"):
        sys.exit("install: [install] skills is not supported yet; leave it empty")
    unknown = [t for t in tools if not os.path.isfile(os.path.join(APP, "bin", t))]
    if unknown:
        sys.exit(f"install: no such tool in bin/: {', '.join(unknown)}")
    package = [os.path.join("fleet", n) for n in listing(os.path.join(APP, "fleet"))
               if os.path.isfile(os.path.join(APP, "fleet", n))]
    sources = package + [os.path.join("bin", t) for t in tools]
    for rel in sources:
        check_source(os.path.join(APP, rel), APP)

    lib = os.path.join(args.prefix, "lib", "fleet")
    binp = os.path.join(args.prefix, "bin")
    etc = os.path.join(args.prefix, "etc", "fleet")
    plan = Plan(args.go, groups, args.diff)

    plan.directory(os.path.join(args.prefix, "lib"), CONFIG_GROUP, 0o2750)
    for d in (lib, os.path.join(lib, "fleet"), os.path.join(lib, "bin")):
        plan.directory(d, CODE_GROUP, 0o2750)
    for rel in sources:
        plan.file(os.path.join(lib, rel), src=os.path.join(APP, rel),
                  mode=0o750 if rel.startswith("bin") else 0o640)
    for n in listing(os.path.join(lib, "fleet")):
        if os.path.join("fleet", n) not in package:
            plan.remove(os.path.join(lib, "fleet", n), "no longer in the package")

    plan.directory(binp, CONFIG_GROUP, 0o2750)
    for t in tools:
        plan.file(os.path.join(binp, t), text=wrapper(lib, etc, t), mode=0o750)
    for t in listing(os.path.join(lib, "bin")):
        if t in tools:
            continue
        plan.remove(os.path.join(lib, "bin", t), "not in [install] tools")
        w = os.path.join(binp, t)
        if os.path.isfile(w):
            with open(w) as f:
                if WRAPPER_MARK in f.read():
                    plan.remove(w, "its wrapper")


    print(f"application : {APP}")
    print(f"config      : {args.config}")
    print(f"into        : {args.prefix}")
    print(f"tools       : {', '.join(tools) or '(none)'}")
    print("MODE        : " + ("INSTALLING" if args.go else "plan only (./install --go to apply)"))
    print()
    c = color(sys.stdout)
    print("\n".join(c(x, "32") for x in plan.actions) if plan.actions else "  nothing to do: already installed")
    for d in plan.diffs:
        print("\n" + pintar(d, c), end="")
    return 0


def color(stream):
    """ANSI colours only on a terminal, and not with NO_COLOR."""
    on = stream.isatty() and not os.environ.get("NO_COLOR")
    return lambda t, code: f"\033[{code}m{t}\033[0m" if on else t


def pintar(diff, c):
    """A diff in colour: file names bold, hunks cyan, added green, removed red."""
    out = []
    for l in diff.splitlines(True):
        code = ("1" if l.startswith(("+++", "---")) else "36" if l.startswith("@@")
                else "32" if l.startswith("+") else "31" if l.startswith("-") else None)
        out.append(c(l.rstrip("\n"), code) + "\n" if code else l)
    return "".join(out)


if __name__ == "__main__":
    sys.exit(main())
