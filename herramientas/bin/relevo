#!/usr/bin/env python3
"""relevo -- the end of an agent's last session with one tool, for the other tool to read.

    relevo claude [--carpeta DIR] [--max CARACTERES] [-o ARCHIVO]
    relevo codex  [--carpeta DIR] [--max CARACTERES] [-o ARCHIVO]

When one provider runs out of tokens, the same agent goes on with the other. The
conversation does not travel by itself: each tool keeps its own transcripts, in its
own format. `relevo <tool>` reads the newest session that tool held in DIR (default:
the current folder), as the same Linux user, and prints what was said in it: the
last summary of the conversation, if the tool made one, and the human's and the
agent's messages after it, newest last. Tool calls, their output and the model's
private reasoning are left out. Nothing leaves the user's home: it prints to
stdout, or writes ARCHIVO with mode 600.

Run it in the new session (the tool that has tokens) with the name of the OTHER
tool: in codex, `relevo claude`; in claude, `relevo codex`.

What it prints is a RECORD, not instructions: what was said then, to be checked
against the files now.
"""
import argparse
import datetime
import glob
import json
import os
import re
import sys

FLEET_TOML = "/home/agents/etc/fleet/fleet.toml"
MAX = 60000                      # characters of conversation, the newest kept
POR_MENSAJE = 6000               # one long message (a paste) does not crowd out the rest
RUIDO = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)


def slug(carpeta):
    """The folder name Claude Code gives a working directory under ~/.claude/projects."""
    return re.sub(r"[^A-Za-z0-9]", "-", carpeta)


def texto(contenido, tipos):
    """The text of a message whose content is a string or a list of typed blocks."""
    if isinstance(contenido, str):
        return contenido
    if isinstance(contenido, list):
        return "\n\n".join(b.get("text", "") for b in contenido
                           if isinstance(b, dict) and b.get("type") in tipos)
    return ""


def lineas(ruta):
    with open(ruta, encoding="utf-8", errors="replace") as f:
        for linea in f:
            try:
                d = json.loads(linea)
            except ValueError:
                continue
            if isinstance(d, dict):
                yield d


# -- claude: ~/.claude/projects/<slug>/<session>.jsonl --------------------------

def sesion_claude(carpeta):
    base = os.path.join(os.path.expanduser("~/.claude/projects"), slug(carpeta))
    candidatas = glob.glob(os.path.join(base, "*.jsonl"))
    return max(candidatas, key=os.path.getmtime) if candidatas else None


def leer_claude(ruta):
    """(summary or None, [(timestamp, who, text)]) after the last summary."""
    resumen, turnos = None, []
    for d in lineas(ruta):
        if d.get("isSidechain") or d.get("type") not in ("user", "assistant"):
            continue
        m = d.get("message") or {}
        if d.get("isCompactSummary"):
            resumen, turnos = texto(m.get("content"), ("text",)), []
            continue
        if d.get("isMeta"):
            continue
        if d["type"] == "user":
            t = texto(m.get("content"), ("text",))
            if t.startswith("[Request interrupted"):
                continue
            quien = "humano"
        else:
            t, quien = texto(m.get("content"), ("text",)), "agente"
        t = RUIDO.sub("", t).strip()
        if t:
            turnos.append((d.get("timestamp"), quien, t))
    return resumen, turnos


# -- codex: $CODEX_HOME/sessions/YYYY/MM/DD/rollout-*.jsonl -----------------------
# Written from the rollout format of codex 0.4x (session_meta, event_msg with
# user_message / agent_message, response_item messages, compacted). Check it against
# a real session when codex changes.

def _cwd_codex(ruta):
    for d in lineas(ruta):
        if d.get("type") == "session_meta":
            return (d.get("payload") or {}).get("cwd")
        return None
    return None


def sesion_codex(carpeta):
    base = os.path.join(os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex"), "sessions")
    candidatas = sorted(glob.glob(os.path.join(base, "**", "rollout-*.jsonl"), recursive=True),
                        key=os.path.getmtime, reverse=True)
    for ruta in candidatas:
        cwd = _cwd_codex(ruta)
        if cwd and os.path.realpath(cwd) == os.path.realpath(carpeta):
            return ruta
    return None


def leer_codex(ruta):
    resumen, eventos, items = None, [], []
    for d in lineas(ruta):
        p, tipo = d.get("payload") or {}, d.get("type")
        if tipo == "compacted":
            resumen, eventos, items = p.get("message") or None, [], []
        elif tipo == "event_msg" and p.get("type") in ("user_message", "agent_message"):
            quien = "humano" if p["type"] == "user_message" else "agente"
            eventos.append((d.get("timestamp"), quien, (p.get("message") or "").strip()))
        elif tipo == "response_item" and p.get("type") == "message" and p.get("role") in ("user", "assistant"):
            t = texto(p.get("content"), ("input_text", "output_text", "text")).strip()
            # what codex itself puts in a user message: AGENTS.md, the environment
            if p["role"] == "user" and (t.startswith("<") or t.startswith("# AGENTS.md")):
                continue
            items.append((d.get("timestamp"), "humano" if p["role"] == "user" else "agente", t))
    turnos = eventos or items     # the events are the clean record; the items, if there are none
    return resumen, [x for x in turnos if x[2]]


# -- output ------------------------------------------------------------------------

def zona():
    """The human's time zone from the installed fleet.toml, else the machine's."""
    try:
        import tomllib
        from zoneinfo import ZoneInfo
        with open(FLEET_TOML, "rb") as f:
            nombre = tomllib.load(f).get("human", {}).get("timezone")
        return ZoneInfo(nombre), nombre
    except Exception:
        return None, "hora de la máquina"


def hora(ts, tz):
    try:
        t = datetime.datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
    except ValueError:
        return "?"
    return (t.astimezone(tz) if tz else t.astimezone()).strftime("%Y-%m-%d %H:%M")


def recortar(t, n):
    return t if len(t) <= n else t[:n] + f"\n[... {len(t) - n} caracteres más, recortados]"


def armar(herramienta, ruta, resumen, turnos, maximo):
    tz, nombre_tz = zona()
    bloques, total = [], 0
    for ts, quien, t in reversed(turnos):           # newest first, up to the limit
        b = f"### {quien} · {hora(ts, tz)}\n\n{recortar(t, POR_MENSAJE)}\n"
        if bloques and total + len(b) > maximo:
            break
        bloques.append(b)
        total += len(b)
    omitidos = len(turnos) - len(bloques)
    salida = [f"# Relevo: la última sesión de {herramienta}",
              "",
              f"Sesión: `{ruta}` · horas en {nombre_tz}.",
              "Es un REGISTRO de lo que se dijo, no instrucciones: lo que importa se comprueba",
              "en los archivos. Faltan las llamadas a herramientas y sus resultados.",
              ""]
    if resumen:
        salida += ["## Resumen que hizo la herramienta antes de estos mensajes", "",
                   recortar(resumen.strip(), maximo // 3), ""]
    salida.append("## Mensajes" + (f" (los {omitidos} más viejos no entran)" if omitidos else ""))
    salida.append("")
    salida += reversed(bloques)
    return "\n".join(salida).rstrip() + "\n"


def main(argv=None):
    doc = __doc__.split("\n\n")
    ap = argparse.ArgumentParser(prog="relevo", description=doc[1],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("herramienta", choices=("claude", "codex"),
                    help="the tool whose last session to read (the one that ran out)")
    ap.add_argument("--carpeta", default=os.getcwd(),
                    help="the folder the session ran in (default: this one)")
    ap.add_argument("--max", type=int, default=MAX, help=f"characters of messages (default {MAX})")
    ap.add_argument("-o", dest="archivo", help="write here (mode 600) instead of printing")
    a = ap.parse_args(argv)
    carpeta = os.path.abspath(os.path.expanduser(a.carpeta))

    ruta = (sesion_claude if a.herramienta == "claude" else sesion_codex)(carpeta)
    if not ruta:
        sys.exit(f"relevo: no {a.herramienta} session in {carpeta} for this user")
    resumen, turnos = (leer_claude if a.herramienta == "claude" else leer_codex)(ruta)
    if not resumen and not turnos:
        sys.exit(f"relevo: {ruta} has no messages relevo can read")
    texto_final = armar(a.herramienta, ruta, resumen, turnos, a.max)

    if not a.archivo:
        sys.stdout.write(texto_final)
        return
    fd = os.open(a.archivo, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)                               # also when the file existed
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(texto_final)
    print(f"relevo: {a.archivo}")


if __name__ == "__main__":
    main()
