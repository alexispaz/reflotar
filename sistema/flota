INSTALADOR_CODEX = "https://chatgpt.com/codex/install.sh"


def actualizar_codex():
    """codex's daemon (`codex agents`) needs codex's own per-user package under
    ~/.codex/packages, which the distribution's /usr/bin/codex lacks. So each agent
    that runs codex gets the standalone install in its home, run AS the agent by sudo,
    at the version fleet.toml fixes: a fixed version is not updated by itself, so a
    new release cannot silently stop loading the rules. The script is downloaded once,
    shown by its sha256, and fed to each agent's sh on stdin: the agent never reads a
    file of yours."""
    import hashlib, tempfile
    cfg = instalado()
    version = str(cfg.get("software", {}).get("codex", ""))
    if not re.fullmatch(r"[0-9][0-9A-Za-z.+-]*", version):
        sys.exit("flota: falta [software] codex = \"<versión>\" en tu fleet.toml (instalado con "
                 "sistema/instalar). Ver la última: https://github.com/openai/codex/releases")
    agentes = [u for u, a in cfg.get("ai_users", {}).items()
               if "codex" in a.get("providers", [a.get("provider")])]
    if not agentes:
        sys.exit("flota: ningún agente de fleet.toml usa codex")
    banda(f"CODEX {version} PARA: {', '.join(agentes)}")
    print()
    for u in agentes:
        rc, out, _ = correr(["sudo", "-u", u, "-H", "sh", "-c",
                             "~/.local/bin/codex --version 2>/dev/null || echo 'sin codex standalone'"], cwd="/")
        print(f"  {u}: {out.strip() or '?'}")
    with tempfile.TemporaryDirectory() as tmp:
        script = os.path.join(tmp, "install.sh")
        if subprocess.run(["curl", "-fsSL", INSTALADOR_CODEX, "-o", script]).returncode != 0:
            sys.exit(f"flota: no pude bajar {INSTALADOR_CODEX}")
        with open(script, "rb") as f:
            datos = f.read()
        lineas = datos.count(b"\n")
        print(f"\n  instalador: {INSTALADOR_CODEX}\n  sha256 {hashlib.sha256(datos).hexdigest()}, "
              f"{lineas} líneas (lo podés leer en otra terminal antes de seguir: {script})")
        if not si(f"\n  ¿Instalo codex {version} para {', '.join(agentes)}?"):
            return
        for u in agentes:
            print(TITULO(f"\n  {u}"))
            with open(script, "rb") as f:
                # cwd "/": the agent cannot enter your current folder, and the
                # installer stumbles where it cannot
                r = subprocess.run(["sudo", "-u", u, "-H", "env", f"CODEX_RELEASE={version}",
                                    "CODEX_NON_INTERACTIVE=true", "sh", "-s"], stdin=f, cwd="/")
            if r.returncode != 0:
                print(AVISO(f"  falló para {u}: sigo con los demás"))
    verificar_codex(agentes, cfg)


