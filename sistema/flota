                print(TENUE(f"    … y {len(carpetas) - 12} más"))
        n = sum(1 for p in pendientes if p.split(",")[0].split("/")[0] == u)
        print(f"  buzón: {n} pedido(s) o propuesta(s) sin responder" if n else TENUE("  buzón: nada sin responder"))


