            time.sleep(0.5)
        else:
            print(AVISO(f"    no salió en un minuto: miralo en {donde[1]}. Si muestra una pregunta "
                        "(cerrar con tareas programadas, por ejemplo), contestala vos: sí la cierra, "
                        "no la deja como estaba"))
            if propio:
                tmux(agente, "set-option", "-p", "-u", "-t", donde[0], "remain-on-exit")
            continue
        aviso = ((SEGUIDA if seguir else NUEVA).format(humano=humano)
                 + (VIGILANTES.format(s=nombre) if s["watchers"] else ""))
        cmd = ["claude", "-n", nombre] + (["-r", s["uuid"]] if seguir and s["uuid"] else []) + [aviso]
        linea = "cd " + shlex.quote(s["cwd"]) + " && " + " ".join(map(shlex.quote, cmd))
        if propio:
            tmux(agente, "respawn-pane", "-t", donde[0], "-c", s["cwd"], linea)
            tmux(agente, "set-option", "-p", "-u", "-t", donde[0], "remain-on-exit")
        else:
            tmux(agente, "send-keys", "-t", donde[0], "-l", linea)
            tmux(agente, "send-keys", "-t", donde[0], "Enter")
        print(OK(f"    reiniciada en {donde[1]}") +
              ("" if seguir or not s["uuid"] else TENUE(f"  (la conversación anterior: claude -r {s['uuid']})")))
    return tiene


def main():
    tema = sys.argv[1] if len(sys.argv) > 1 else None
    resto = sys.argv[2:]
    if tema == "pasar":
        exigir_grupos()
        borrar = "--borrar" in resto
        resto = [r for r in resto if r != "--borrar"]
        arbol = None
        if "--arbol" in resto:
            k = resto.index("--arbol")
            if k + 1 >= len(resto):
                sys.exit("uso: --arbol RAIZ")
            arbol = resto[k + 1]
            del resto[k:k + 2]
        if len(resto) < 2:
            sys.exit("uso: flota pasar ORIGEN DESTINO: los dos lados, siempre. Un proyecto:\n"
                     "        flota pasar . pensadero      de acá a su copia en pensadero\n"
                     "        flota pasar pensadero .      de pensadero a acá\n"
                     "      un archivo o una carpeta suelta, adonde digas:\n"
                     "        flota pasar ~/x.pdf pensadero:lineas/linea_a/\n"
                     "      flota pasar ORIGEN... DESTINO [--arbol RAIZ] [--borrar]")
        if len(resto) == 2 and not arbol:
            proyecto = como_proyecto(*resto)
            if proyecto and archivo_de_proyecto(*proyecto):
                return pasar(*archivo_de_proyecto(*proyecto), borrar=borrar)
            if proyecto:
                return pasar_proyecto(proyecto[0], borrar=borrar, flota_pedida=proyecto[1])
        return pasar(resto[:-1], resto[-1], borrar=borrar, arbol=arbol)
    if tema == "mover":
        exigir_grupos()
        if len(resto) != 2:
            sys.exit("uso: flota mover ORIGEN DESTINO   (por ejemplo: codex:repo_clases pensadero)")
        return mover(*resto)
    if tema in ("traer", "entregar", "clonar"):
        exigir_grupos()
    if tema == "traer" and resto and lugar(resto[0])[0]:
        if len(resto) > 2:
            sys.exit("uso: flota traer USUARIO:REPO")
        u, _, src = lugar(resto[0])
        for clon in clones():          # a repo you have a clone of: its branches
            for remoto, nombre in remotos_de_agentes(clon).items():
                if remoto == u and f"{CASAS}/{u}/work/{nombre}" == src and len(resto) == 1:
                    return traer(clon)
        sys.exit(f"flota: {src} is no repository you have a clone of: to copy it, flota pasar")
    if tema == "traer":
        if len(resto) > 1:
            sys.exit("uso: flota traer [CLON]   o   flota traer RUTA [DESTINO]")
        if resto and not clones(raiz_de(resto[0])):
            return traer_sin_clon(raiz_de(resto[0]))
        return traer(raiz_de(resto[0], avisar=True) if resto else None)
    if tema == "instalar":
        os.execv(os.path.join(AQUI, "sistema", "instalar"), ["instalar", *resto])
    if tema == "entregar" and not resto:
        exigir_grupos()
        return entregar_todo()
    if tema == "entregar":
        if len(resto) not in (1, 2):
            sys.exit("uso: flota entregar CLON [DESTINO]   (sin DESTINO, a quien ya lo tiene; "
                     "por ejemplo: flota entregar ~/agents/x claude); para copiar, flota pasar")
        return entregar_a(raiz_de(resto[0], avisar=True) if not lugar(resto[0])[0] else resto[0], *resto[1:])
    if tema == "actualizar":
        if not resto:
            exigir_grupos()
            sys.exit(actualizar_flota())
        if resto != ["codex"]:
            sys.exit("uso: flota actualizar          trae las ramas de flota y de tu configuración, e instala\n"
                     "      flota actualizar codex    codex en la versión de fleet.toml (claude se actualiza con "
                     "el gestor de paquetes: es del sistema)")
        return actualizar_codex()
    if tema == "clonar":
        rama = []
        if "--rama" in resto:
            i = resto.index("--rama")
            rama, resto = resto[i:i + 2], resto[:i] + resto[i + 2:]
        if len(resto) not in (2, 3) or len(rama) == 1:
            sys.exit("uso: flota clonar AGENTE REPO [DESTINO] [--rama RAMA]")
        return clonar(resto + rama)
    if tema == "estado":
        if len(resto) > 1:
            sys.exit("uso: flota estado [CARPETA]   (. para la de acá; o pensadero:proyecto)")
        if resto:
            exigir_grupos()
            estado_carpeta(resto[0])
            return
        return estado()
    if tema == "cluster":
        if not resto:
            sys.exit("uso: flota cluster CLUSTER [AGENTE...]")
        return cluster(resto[0], resto[1:])
    if tema in ("-h", "--help"):
        print(__doc__)
        return
    if tema == "arrancar":
        return arrancar(resto)
    if tema == "reiniciar":
        return reiniciar(resto)
    if not tema:
        pendiente()                 # what needs you now, first; then the cheat sheet
    chuleta(tema)


if __name__ == "__main__":
    main()
