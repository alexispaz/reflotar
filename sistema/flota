def ultima_version(paquete):
    """The newest version npm publishes of a package, or None (offline, or the registry
    said something else). Only read: nothing is installed."""
    import urllib.request
    try:
        with urllib.request.urlopen(f"https://registry.npmjs.org/{paquete}/latest", timeout=6) as f:
            v = json.load(f).get("version")
    except Exception:
        return None
    return v if isinstance(v, str) and re.fullmatch(r"[0-9][0-9A-Za-z.+-]*", v) else None


def mas_nueva(a, b):
    """True when version b is newer than a (numbers compared as numbers)."""
    clave = lambda v: [int(x) if x.isdigit() else x for x in re.split(r"[.+-]", v)]
    try:
        return clave(b) > clave(a)
    except TypeError:
        return a != b


def avisar_proveedores():
    """Only a notice: a newer codex than the one fleet.toml pins, or a newer Claude Code
    than the one installed. Neither is updated here: codex moves version through
    fleet.toml and the aparejador (docs/instalacion.md), claude with the package manager."""
