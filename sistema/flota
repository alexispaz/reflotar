def lugar(texto):
    """scp-like: 'claude:proyecto_a' -> ('claude', ~claude/work/proyecto_a); 'claude:' or a bare
    AI user -> its whole ~/work (the pensadero's too); a path under an AI user's
    home -> that user and the path; anything else -> (None, your path)."""
    usuarios = instalado().get("ai_users", {})
    u, sep, rel = texto.partition(":")
    if u in usuarios and (sep or texto == u):
        base = f"{CASAS}/{u}/work"
        rel = rel.strip("/")
        if ".." in rel.split("/"):
            sys.exit(f"flota: {texto}: no '..' inside an AI user's folder")
        return u, base, os.path.join(base, rel) if rel else base
    ruta = os.path.realpath(os.path.expanduser(texto))
    return de_un_agente(ruta), None, ruta


def duenos(lista):
    """{AI user: folder in its ~/work} of the agents that already have these clones (one
    repo, or every repo of a group, in the same group folder), from your clones' agent
    remotes. A remote whose folder is gone is left out: it is listed apart."""
    usuarios = instalado().get("ai_users", {})
    tienen, muertos = None, set()
    for repo in lista:
        aca = {}
        for remoto, rel in remotos_de_agentes(repo).items():
            if remoto not in usuarios:
                continue
            if not os.path.isdir(git(repo, "config", f"remote.{remoto}.url")[1]):
                muertos.add((repo, remoto))
                continue
            aca[remoto] = rel if len(lista) == 1 else os.path.dirname(rel)
        tienen = aca if tienen is None else {u: r for u, r in tienen.items() if aca.get(u) == r}
    return tienen or {}, sorted(muertos)


