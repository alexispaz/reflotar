    cfg = instalado()
    usan = lambda p: any(p in a.get("providers", [a.get("provider")])
                         for a in cfg.get("ai_users", {}).values())
    if usan("codex"):
        fijada, ultima = str(cfg.get("software", {}).get("codex", "")), ultima_version("@openai/codex")
        if not ultima:
            print(TENUE("  codex: no pude consultar la última versión (npm)"))
        elif fijada and mas_nueva(fijada, ultima):
            print(AVISO(f"  codex: fijada {fijada}; hay {ultima}. Para pasar: [software] codex en fleet.toml, "
                        "flota actualizar, flota actualizar codex, y que el aparejador revise (docs/instalacion.md)"))
        else:
            print(OK(f"  codex {fijada}: la última"))
    if usan("claude"):
        rc, out = 1, ""
        try:
            p = subprocess.run(["claude", "--version"], capture_output=True, text=True, timeout=20)
            rc, out = p.returncode, p.stdout
        except (OSError, subprocess.TimeoutExpired):
            pass
        m = re.match(r"\s*([0-9][0-9A-Za-z.+-]*)", out) if rc == 0 else None
        ultima = ultima_version("@anthropic-ai/claude-code")
        if not m or not ultima:
            print(TENUE("  claude: no pude ver la versión instalada o la última (npm)"))
        elif mas_nueva(m.group(1), ultima):
            print(AVISO(f"  claude: instalado {m.group(1)}; hay {ultima}. Se actualiza con tu gestor de "
                        "paquetes, cuando lo empaqueta (en Arch, sudo pacman -Syu)"))
        else:
            print(OK(f"  claude {m.group(1)}: la última"))


