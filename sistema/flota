def entregar_a(origen, destino=None):
    """flota entregar CLON [DESTINO]: a destination folder that exists gets the clone inside
    it, unless it is the agent's copy of that repo already (then it is brought up to
    date). Without DESTINO, it goes to the AI user that already has it, where it has it.
    To anyone else, it asks first: that is a second copy. The old order (AGENTE CLON) is
    turned around."""
    usuarios = instalado().get("ai_users", {})
    if destino and origen in usuarios and lugar(destino)[0] is None:          # the old order
        origen, destino = destino, origen
    u_o, _, src = lugar(origen)
    lista = [] if u_o else clones(src)
    if not lista:
        sys.exit(f"flota: {src} is not a clone of yours (nor a folder of them): to copy it, flota pasar")
    tienen, muertos = duenos(lista)
    avisar_muertos(muertos)
    if destino is None:
        if len(tienen) == 1:
            (u_d, rel), = tienen.items()
            print(f"{corto(src)} -> {u_d}:{rel} (quien ya lo tiene)")
            return entregar(u_d, src, rel)
        if not tienen:
            sys.exit(f"flota: ningún agente tiene {corto(src)} todavía: decí a quién, "
                     f"flota entregar {origen} claude")
        sys.exit(f"flota: {corto(src)} lo tienen " + ", ".join(f"{u}:{r}" for u, r in tienen.items())
                 + f": decí a cuál, flota entregar {origen} <usuario IA>")
    u_d, base, dst = lugar(destino)
    if u_d is None or base is None:
        sys.exit("flota: the destination is an AI user: `claude`, or `claude:nombre`")
    adentro = os.path.isdir(dst) and not os.path.exists(os.path.join(dst, ".git"))
    final = os.path.join(dst, os.path.basename(src)) if adentro else dst
    rel = os.path.relpath(final, base)
    if rel.startswith("..") or rel == ".":
        sys.exit(f"flota: {final} is not inside {base}")
    if tienen and tienen.get(u_d) != rel:
        (u_t, r_t), = list(tienen.items())[:1]
        sys.exit(f"flota: {corto(src)} ya lo tiene {u_t}:{r_t}, y un proyecto vive en una sola flota. "
                 f"Para ponerle al día su copia: flota entregar {origen}. Para pasárselo a {u_d}: "
                 f"flota mover {u_t}:{r_t} {u_d}")
    return entregar(u_d, src, rel)


