def sesiones_claude(agente):
    """fleetcontext's list for an AI user without the fleet's tools: each session is
    named by its tmux window (`claude -n <name>` names both), else its folder. When two
    share a folder, the transcript is not known: no uuid, so --seguir leaves them."""
    rc, out, err = como(agente, "sh", "-c", CLAUDE_SH)
    if rc:
        print(AVISO(f"flota: no pude preguntarle a {agente}: {(err.strip().splitlines() or ['?'])[-1]}"))
        return None
    rc, panes, _ = tmux(agente, "list-panes", "-a", "-F", "#{pane_pid} #{pane_id} #{session_name}:#{window_name}")
    paneles = {int(l.split()[0]): l.split()[1:] for l in panes.splitlines() if l.strip()} if rc == 0 else {}
    filas = [l.split("|", 4) for l in out.splitlines() if l.startswith("C|")]
    carpetas = [f[4] for f in filas if len(f) == 5]
    sesiones = []
    for _, pid, uuid, mtime, cwd in (f for f in filas if len(f) == 5):
        donde = panel_de(int(pid), paneles)
        unica = carpetas.count(cwd) == 1
        sesiones.append({"session": donde[1].split(":", 1)[1] if donde else os.path.basename(cwd),
