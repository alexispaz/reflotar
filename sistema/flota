def traer(destino=None, lista=None):
    lista = lista if lista is not None else clones(destino)
    if destino and not lista:
        sys.exit(f"flota: no git repository in {destino}")
    cambiados = {}                               # clone -> {remote: agent's repo name}
    for repo in lista:
        remotos = remotos_de_agentes(repo)
        if not remotos:
            if destino:
                sys.exit(f"flota: {repo} has no agent remote (clonar.py or entregar-repo adds one)")
            continue
        base = principal(repo)
        if not base:
            print(AVISO(f"\n{corto(repo)} no tiene main ni master: no sé contra qué rama comparar; lo salteo"))
            continue
        for remoto, nombre_agente in remotos.items():
            print(TENUE(f"\n{corto(repo)}: git fetch {remoto} (sudo puede pedir tu contraseña)"))
            if git(repo, "fetch", remoto, capturar=False)[0] != 0:
                print(AVISO(f"  no pude traer de {remoto}: sigo con lo que ya estaba"))
                if not os.path.isdir(git(repo, "config", f"remote.{remoto}.url")[1]):
                    avisar_muertos([(repo, remoto)])
            vistas = set()
            while True:
                ramas = [r for r in ramas_nuevas(repo, remoto, base) if r not in vistas]
                if not ramas:
                    break
                rama = ramas[0]
                vistas.add(rama)
                revisar(repo, rama, base)
                if not si(f"  ¿Mergeo {rama} en {corto(repo)}?", defecto=True):
                    print(TENUE("  no la mergeé"))
                    continue
                actual = git(repo, "symbolic-ref", "--short", "HEAD")[1]
                sucio = git(repo, "status", "--porcelain", "--untracked-files=no")[1]
                if actual != base or sucio:
                    print(AVISO(f"  {corto(repo)} no está limpio en {base}"
                                f" (rama {actual or '?'}{', con cambios' if sucio else ''}): no mergeo"))
                    continue
                if git(repo, "merge", "--ff-only", "-q", rama, capturar=False)[0] != 0:
                    suya = rama        # its fetch maps <agent>/<topic> onto the same name
                    print(AVISO(f"  {rama} salió de un {base} viejo: tu {base} avanzó después. No toco nada."))
                    parrafo(f"Si ya le entregaste tu {base}, decile en su ventana: \"Mergeá "
                            f"{getpass.getuser()}/{base} en {suya} (merge, no rebase) y avisame\". Si no, "
                            f"primero: flota entregar {repo} {remoto}. Después, otra vez flota traer.", "  ")
                    continue
                print(OK(f"  mergeada: {rama}"))
                cambiados.setdefault(repo, {})[remoto] = nombre_agente
                if repo == AQUI:
                    print(AVISO("  flota se actualizó: lo que sigue (instalar, entregar) ya usa la versión nueva"))
    if not cambiados:
        print("\nNada nuevo para mergear.")
        return
    instala = [r for r in cambiados if r == AQUI or os.path.basename(r).startswith("flota-")]
    if instala and lista != repos_de_la_flota():
        print(AVISO("\n  Cambió " + ", ".join(os.path.basename(r) for r in instala)
                    + ": para instalarlo, flota actualizar (o flota instalar --go)"))
    banda("ENTREGAR TU MAIN A LOS AGENTES")
    print()
    parrafo("Así su copia queda al día con lo que aceptaste (`entregar-repo`).", "  ")
    for repo, remotos in cambiados.items():
        for agente, nombre in remotos.items():
            if si(f"  ¿Le entrego tu main de {corto(repo)} a {agente}?", defecto=True):
                subprocess.run([os.path.join(AQUI, "sistema", "entregar-repo"), agente, repo,
                                "--name", nombre, "--go"])


