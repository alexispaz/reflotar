#!/usr/bin/env python3
"""flota -- what the human can do with the fleet, and what is pending now.

    flota            what is pending now, then the cheat sheet (COMANDOS.md)
    flota <tema>     only the sections whose title contains <tema> (clusters, repos...)
    flota arrancar [USUARIO...]
                     start the fleets (all, or the AI users named): each working
                     user's cluster key (you type the passphrase), its tmux and its
                     coord resumed, asked to resume the other sessions; the
                     pensadero's maestro resumed. You land in the first one
    Places, as scp writes them: `claude:proyecto_a` is ~claude/work/proyecto_a (a línea of the
    pensadero: pensadero:lineas/namd), `claude:` or `claude` its whole ~/work; a plain
    path is yours.
    As cp does, a destination that is a folder already gets the thing INSIDE it.

    flota pasar . FLOTA  ·  flota pasar FLOTA .
                     a project, between your ~/agents/<path> and its copy in its one
                     fleet (a bare fleet name means that same path there): its repos by git (handed
                     over, or brought with your review; a new one cloned safely), the
                     rest by rsync, never a file git follows nor over a newer one.
                     Shows flota estado's comparison, one summary, asks once
    flota pasar ORIGEN... DESTINO [--arbol RAIZ] [--borrar]
                     a folder or a file, never a .git, from you to an AI user (`flota
                     pasar ~/ideas pensadero`), back (`flota pasar pensadero:ideas
                     ~/agents`), or between them (`flota pasar claude:x pensadero`).
                     rsync, one way: shows what would change, asks, copies what
                     changed. Run it again to bring the copy up to date. Deletes
                     nothing unless --borrar (then the destination ends up as the
                     origin, and the list shows what goes). Out of the pensadero, to
                     anyone but you, it asks first. Folders the destination needs
                     are created (`claude:proyecto/docs/`, with the slash: inside it).
                     Several origins go inside DESTINO, each by its name; with
                     --arbol RAIZ each keeps its path under RAIZ (`flota pasar
                     --arbol ~/gd ~/gd/a/x ~/gd/b/y pensadero:gd` makes gd/a/x, gd/b/y)
    flota traer USUARIO:REPO         the branches of a repo you have a clone of
    flota traer [CLON]   bring the agents' new branches into your clones under
                     ~/agents (or one of them; `.` is the repo you are in): fetch, show each branch's commits
                     and diff, merge it if you say so (--ff-only); then offer to
                     hand your main back to the agent. It does not install: if flota
                     or your configuration changed, it says so
    flota actualizar     the fleet itself: the architect's branches of flota and of
                     your flota-<you> only (as flota traer), then sistema/instalar --go
    flota instalar [--go]            sistema/instalar
    flota entregar       every clone of yours whose main its fleet lacks, to that
                     fleet: one list, one question
    flota entregar CLON [DESTINO]    a clone of yours to a working AI user (`flota entregar
                                     ~/agents/x claude`, or `claude:otro/x`); the old
                                     order, AGENTE CLON, still works. Without DESTINO,
                                     to the AI user that already has it (`flota
                                     entregar .`); to another, it asks first.
                                     sistema/entregar-repo --go; given a folder
                                     of related repos (~/agents/rc), each of them, into
                                     the same folder in the agent's ~/work (~/work/rc).
                                     Anything else: flota pasar
    flota mover ORIGEN DESTINO
                     a folder (a repo, a group of repos, or plain files) from one AI user
                     to another (`flota mover codex:repo_clases pensadero`). Stops if
                     anything could be lost (uncommitted work, unaccepted branches, a
                     session working there). Repos keep their history, in your clones
                     and in the destination; the origin goes to its AI user's
                     ~/work/TRASH, with a line in TRASH/README.md
    flota clonar AGENTE REPO [DEST] [--rama RAMA]
                                     show clonar.py's commands, and run them if you say so
    flota estado     each AI user: its roles and clusters, its live sessions (where,
                     how long quiet; claude's tokens), its folders and when each
                     last changed, and its unanswered mail. Reads only; asks each
                     AI user with sudo -u, as flota reiniciar does
    flota estado CARPETA
                     your copy of a project against the fleet's, changing nothing:
                     `.` (or a path under ~/agents, its fleet deduced) or
                     pensadero:proyecto. Its repos: branches to bring, commits of
                     your main the fleet lacks. The rest, outside git on both sides:
                     files only here, only there, newer on which side, and their size
    flota cluster CLUSTER [AGENTE...]
                     clusters/add-cluster for each AI user with a box there in
                     fleet.toml (or those named): shows its plan, asks, then --go
    flota actualizar codex           install, for every agent that runs codex, the version
                                     [software] codex of fleet.toml (fixed: no automatic
                                     updates), then check each still loads its rules
    flota reiniciar [--seguir] [--forzar] [USUARIO...] [SESIÓN...]
                     restart the claude sessions of every AI user that runs claude
                     (the pensadero's too), or of those named, so they load the
                     installed rules, coord first (codex ones too: /exit, then codex
                     or, with --seguir, codex resume <its thread>): shows each one's context, idleness and watchers, asks,
                     then types /exit and starts it again in the same pane. Fresh by
                     default (no conversation; it is told to read its notes and wait);
                     --seguir resumes the same conversation (claude -r); --forzar
                     restarts it even if it was active in the last 2 minutes

Every step that changes something asks first, and a branch is merged only after
you have been shown its diff. git runs only in your own clones; nothing is pushed.

Run as yourself, from your clone (alias flota=~/agents/flota/sistema/flota).
It changes nothing. What is pending is derived now, never kept:
  - proposals in the mailbox that nobody has answered yet (buzon);
  - whether the planner has something to install (it runs it, which only prints);
  - agent branches not merged into main in your clones under ~/agents, as of your
    last `git fetch` (it does not fetch: that asks for your sudo password).
"""
import getpass, glob, grp, json, os, re, shlex, shutil, subprocess, sys, textwrap, time, unicodedata

AQUI = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))   # the clone
CHULETA = os.path.join(AQUI, "COMANDOS.md")
BUZON = "/home/agents/bin/buzon"
CLONES = os.path.expanduser("~/agents")


def plano(t):
    return "".join(c for c in unicodedata.normalize("NFD", t.lower()) if not unicodedata.combining(c))


def color(codigo):
    on = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    return lambda t: f"\033[{codigo}m{t}\033[0m" if on else t


BANDA, TITULO, TENUE, AVISO, CODIGO, OK = (color("1;7;36"), color("1"), color("2"),
                                           color("1;33"), color("33"), color("32"))
ANCHO = max(40, min(100, shutil.get_terminal_size((100, 24)).columns))   # 40: a phone


def banda(texto):
    """A section title: a full-width bar, easy to find when scrolling."""
    print("\n" + BANDA(f" {texto} ".ljust(ANCHO)))


def codigo(linea, abierto=False):
    """`code` spans in colour, backticks dropped. A span may run over a wrapped line,
    so the state carries from one line to the next."""
    partes, out = linea.split("`"), []
    for i, p in enumerate(partes):
        if i:
            abierto = not abierto
        out.append(CODIGO(p) if abierto and p else p)
    return "".join(out), abierto


def parrafo(texto, sangria, estilo=None):
    abierto = False
    for linea in textwrap.wrap(texto, ANCHO - len(sangria), break_on_hyphens=False) or [""]:
        hecho, abierto = codigo(linea, abierto)
        print(sangria + (estilo(hecho) if estilo else hecho))


def chuleta(tema=None):
    with open(CHULETA, encoding="utf-8") as f:
        texto = f.read()
    humano = instalado().get("human", {})
    for k in ("name", "user", "timezone"):          # its templates, as the planner fills them
        if humano.get(k):
            texto = texto.replace("{{human." + k + "}}", humano[k])
    partes = re.split(r"(?m)^(?=## )", texto)
    if tema:
        partes = [p for p in partes[1:] if plano(tema) in plano(p.splitlines()[0])]
        if not partes:
            temas = [p.splitlines()[0][3:] for p in re.split(r"(?m)^(?=## )", texto)[1:]]
            sys.exit(f"flota: no hay sección '{tema}'. Temas: {', '.join(temas)}")
    for p in partes:
        lineas, suelto = p.rstrip().splitlines(), []
        for linea in lineas + [""]:
            if suelto and not linea.strip() or linea.startswith(("#", "|")):
                if suelto:                            # plain text dimmed; a "Nunca..." stands out
                    texto_p = " ".join(suelto)
                    parrafo(texto_p, "  ", AVISO if texto_p.startswith("Nunca") else TENUE)
                    print()
                    suelto = []
            if linea.startswith("# "):
                banda(linea[2:].strip().upper())      # the file's own title
                print()
                continue
            if linea.startswith("## "):
                banda(linea[3:].strip().upper())
                print()
            elif linea.startswith(("| :---", "| quiero")):
                continue                              # the table's header
            elif linea.startswith("|"):
                celdas = [c.strip() for c in linea.strip().strip("|").split("|")]
                parrafo(celdas[0], "  > ", TITULO)    # what you want
                parrafo(" | ".join(celdas[1:]), "      ")   # how
                print()
            elif linea.strip():
                suelto.append(linea.strip())


def clones(carpeta=None):
    """Your clones: CARPETA itself if it is a repo, else the repos directly in it.
    Without CARPETA, those of ~/agents: each repo there, and the repos in each folder
    of related repos there (~/agents/<group>/<repo>)."""
    if carpeta:
        carpeta = os.path.realpath(os.path.expanduser(carpeta))
        if os.path.isdir(os.path.join(carpeta, ".git")):
            return [carpeta]
        return sorted(os.path.dirname(g) for g in glob.glob(os.path.join(carpeta, "*", ".git")))
    out = []
    for d in sorted(glob.glob(os.path.join(CLONES, "*", ""))):
        out += clones(d)
    return out


def raiz_de(carpeta, avisar=False):
    """The repo that holds carpeta, when carpeta is inside one under ~/agents (`.` in
    ~/agents/x/src is ~/agents/x); else carpeta itself. avisar: say so (traer and
    entregar, which then work on that repo)."""
    carpeta = os.path.realpath(os.path.expanduser(carpeta))
    tope = os.path.realpath(CLONES)
    d = carpeta
    while d.startswith(tope + "/"):
        if os.path.isdir(os.path.join(d, ".git")):
            if d != carpeta and avisar:
                print(TENUE(f"{carpeta} está adentro del repo {d}: uso el repo"))
            return d
        d = os.path.dirname(d)
    return carpeta


def corto(repo):
    """rc/a for ~/agents/rc/a; the folder's name elsewhere."""
    rel = os.path.relpath(repo, CLONES)
    return rel if not rel.startswith("..") else os.path.basename(repo)


def correr(cmd, cwd=None):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, cwd=cwd, timeout=120)
        return r.returncode, r.stdout, r.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def item(estado, que, explica, hacer=None):
    """One pending item: its state, one line on what it means, and what to do."""
    marca = OK("  ok ") if estado == "ok" else AVISO("  !! ") if estado == "hay" else AVISO("  ?? ")
    print(marca + TITULO(que))
    parrafo(explica, "       ", TENUE)
    if hacer:
        parrafo("-> " + hacer, "       ")
    print()


def grupos_sin_activar():
    """Your groups that this login does not carry yet: the plan adds you to the AI
    users' groups, and a group applies only to a new login."""
    activos = set(os.getgroups())
    yo = getpass.getuser()
    return sorted(g.gr_name for g in grp.getgrall() if yo in g.gr_mem and g.gr_gid not in activos)


GRUPOS = ("Tu sesión todavía no tiene los grupos {g}: Linux los aplica solo en un login nuevo, "
          "y una terminal nueva del mismo escritorio hereda los viejos. Cerrá la sesión del "
          "escritorio y volvé a entrar; para seguir ya en esta terminal: exec su -l $USER")


def exigir_grupos():
    """Stop, with what to do, before a command that needs the AI users' groups."""
    faltan = grupos_sin_activar()
    if faltan:
        sys.exit("flota: " + GRUPOS.format(g=", ".join(faltan)))


def pendiente():
    banda("PENDIENTE AHORA")
    print()
    faltan = grupos_sin_activar()
    if faltan:
        item("hay", f"grupos sin activar: {', '.join(faltan)}", GRUPOS.format(g=", ".join(faltan)),
             "cerrá la sesión y volvé a entrar, o `exec su -l $USER`")
    for u in sin_box():
        item("hay", f"{u} no tiene box en ningún cluster",
             "Es un usuario IA de trabajo, y tus clusters solo declaran box para otros: sus "
             "sesiones no pueden trabajar en ninguno.",
             f"agregá {u} al `box` de cada cluster en tu fleet.toml, hacé su llave en "
             f"`t{u}` y corré `clusters/add-cluster <cluster> {u} --go` (docs/clusters.md)")
    rc, out, err = correr([BUZON, "listar", "--tipo", "propuesta", "--sin-respuesta"])
    if rc != 0:
        item("?", "propuestas: no pude preguntarle al buzón",
             (err.strip().splitlines() or ["?"])[-1])
    else:
        n = len(re.findall(r"(?m)^[ *] \d{8}-", out))
        item("hay" if n else "ok", f"propuestas sin procesar: {n}",
             "Mejoras a las reglas que propusieron los agentes y nadie revisó todavía.",
             'decile al arquitecto: "procesá lo aprendido"' if n else None)
    rc, out, err = correr([sys.executable, os.path.join(AQUI, "sistema", "plan-agentes.py")], cwd=AQUI)
    if rc != 0:
        item("?", "instalación: el planner falló", (err.strip().splitlines() or ["?"])[-1])
    else:
        # routine checks (what the planner cannot see, in the AI users' homes) are
        # always there and change nothing when all is in place: count the changes
        m = re.search(r"(?m)^# changes: (\d+), routine checks: (\d+)$", out)
        reales, rutinas = (int(m.group(1)), int(m.group(2))) if m else (0, 0)
        m = re.search(r"FILES THAT CHANGE \((\d+)\)", err)
        archivos = int(m.group(1)) if m else 0
        item("hay" if reales else "ok",
             f"por instalar: {archivos} archivo(s) que cambian, {reales} cambio(s) en total",
             "Lo que tus clones tienen y la máquina todavía no. Las "
             f"{rutinas} comprobaciones de rutina (carpetas de los usuarios IA "
             "que no podés ver) no cuentan: no cambian nada si todo está en su lugar.",
             "`flota instalar` para ver qué cambia; `flota instalar --go` para aplicarlo" if reales else None)
    ramas, sin = [], []
    for repo in clones():
        base = principal(repo)
        if not base:
            sin.append(os.path.relpath(repo, CLONES))
            continue
        rc, out, _ = correr(["git", "-C", repo, "branch", "-r", "--no-merged", base, "--list",
                             *(f"{u}/*" for u in instalado().get("ai_users", {}) or ("claude", "codex"))])
        for r in out.split():
            if not r.endswith(("/main", "/master", "/HEAD", "->")):
                ramas.append(f"{os.path.relpath(repo, CLONES)}: {r}")
    if sin:
        item("hay", f"clones sin main ni master: {', '.join(sin)}",
             "No puedo saber qué ramas de agentes faltan aceptar ahí.",
             "creá la rama principal (`git switch -c main`) en cada uno")
    item("hay" if ramas else "ok", f"ramas de agentes sin mergear: {len(ramas)}",
         "Trabajo que un agente te dejó para revisar, según tu último `git fetch claude`.",
         "`flota traer`: te muestra cada una y la mergea si le decís que sí" if ramas else None)
    for r in ramas:
        print("         " + r)


# What `flota arrancar` runs as the claude coordinator's user, inside `sudo machinectl
# shell <user>@`, so the
# session lands in claude's own slice, as with tclaude. Fixed text from YOUR clone;
# nothing an agent wrote is run. The passphrase is typed by you, in your terminal,
# into ssh-add itself: never into a window an agent opened. Each @program@ is the
# absolute path YOUR PATH gives (binario), so nothing in the agent's own PATH
# (~/.local/bin) is run in its place.
LLAVE = r"""
set -u
sock="$HOME/.ssh/agente.sock"
if ! compgen -G "$HOME/.ssh/id_*.pub" >/dev/null; then   # no key yet: no clusters to open
  echo "$(id -un) no tiene llave de clusters todavía: arranco sin ssh-agent"
else
  SSH_AUTH_SOCK="$sock" @ssh-add@ -l >/dev/null 2>&1; rc=$?
  if [ "$rc" = 2 ]; then                    # no agent behind the socket: start one
    rm -f "$sock"
    @ssh-agent@ -a "$sock" >/dev/null || { echo "flota: no pude arrancar ssh-agent"; exit 1; }
    rc=1
  fi
  if [ "$rc" = 1 ]; then
    echo "Clave de los clusters para $(id -un) (queda abierta hasta ssh-add -D o un reinicio):"
    SSH_AUTH_SOCK="$sock" @ssh-add@ || echo "(sin clave: los agentes no van a entrar a los clusters)"
  fi
fi
"""
VENTANA = r"""
if ! @tmux@ has-session -t @sesion@ 2>/dev/null; then
  @tmux@ new-session -d -s @sesion@ -n @ventana@ -c "$HOME/@carpeta@"; nuevo=1
elif ! @tmux@ list-windows -t @sesion@ -F '#W' | grep -qx @ventana@; then
  @tmux@ new-window -d -t @sesion@ -n @ventana@ -c "$HOME/@carpeta@"; nuevo=1
else
  echo "$(id -un): @ventana@ ya tiene su ventana en @sesion@: no lo arranco de nuevo"; nuevo=0
fi
# typed by YOUR script into a fresh shell: the prompt is yours, not an agent's
[ "$nuevo" = 1 ] && @tmux@ send-keys -t @sesion@:@ventana@ @orden@ Enter
"""
DESPERTADOR = r"""
if @pgrep@ -u "$(id -u)" -f '/home/agents/bin/buzon despertador' >/dev/null; then
  echo "$(id -un): el despertador ya corre"
else
  mkdir -p "$HOME/.local/state/buzon"
  @setsid@ @nohup@ /home/agents/bin/buzon despertador >> "$HOME/.local/state/buzon/despertador.log" 2>&1 < /dev/null &
  echo "$(id -un): despertador arrancado (registro: ~/.local/state/buzon/despertador.log)"
fi
"""
# How each role resumes its last conversation; coord is asked to resume the rest.
REANUDAR = {("claude", "coord"): 'claude -c -n coord "Retomá la flota"',
            ("codex", "coord"): 'codex resume --last "Retomá la flota"',
            ("claude", "maestro"): 'claude -c -n maestro "Retomá el pensadero"',
            ("codex", "maestro"): 'codex resume --last "Retomá el pensadero"'}


def arranques():
    """{AI user: (tmux session, window, folder, command)} of what flota arrancar opens:
    each working AI user's coord, in its first provider, and each pensadero's maestro,
    in claude when it has claude (from there it reaches agents of both tools)."""
    out = {}
    for u, a in instalado().get("ai_users", {}).items():
        provs = a.get("providers") or [a.get("provider", "claude")]
        pv = provs[0]
        roles = set(a.get("roles", []))
        if roles & {"pensadero", "maestro"} and "claude" in provs:
            pv = "claude"
        if "coord" in roles:
            out[u] = ("flota", "coord", "coord", REANUDAR[(pv, "coord")])
        elif roles & {"pensadero", "maestro"}:
            out[u] = (u, "maestro", "maestro", REANUDAR[(pv, "maestro")])
    return out


def binario(nombre):
    """The absolute path of a program, as YOUR PATH finds it. It goes into what runs as
    an agent, so the agent's own PATH never chooses the program."""
    ruta = shutil.which(nombre)
    if not ruta:
        sys.exit(f"flota: no encuentro {nombre} en tu PATH")
    return ruta


def instalado():
    """The installed fleet.toml, or {} if it cannot be read."""
    import tomllib
    try:
        with open("/home/agents/etc/fleet/fleet.toml", "rb") as f:
            cfg = tomllib.load(f)
    except (OSError, ValueError):
        return {}
    if "ai_users" not in cfg and "agents" in cfg:   # the old name of [ai_users]
        cfg["ai_users"] = cfg.pop("agents")
    return cfg


def de_trabajo():
    """The working AI users (not a pensadero) of the installed fleet.toml."""
    return [u for u, a in instalado().get("ai_users", {}).items()
            if not {"pensadero", "maestro"} & set(a.get("roles", []))]


def sin_box():
    """Working AI users with a box on no cluster, when the fleet has clusters at all
    (codex had none on any, 2026-10-16, and nothing said so)."""
    clusters = instalado().get("cluster", {})
    if not clusters:
        return []
    con = {u for c in clusters.values() for u in c.get("box", {})}
    return [u for u in de_trabajo() if u not in con]


def arrancar(quienes=()):
    """Start the fleets after a reboot or a crash, every one or those named: the cluster
    key of each working AI user (you type each passphrase), then its tmux with its
    session resumed: coord, asked to resume the rest; a pensadero's maestro. You land in
    the first one's window; the others wait in theirs (tclaude, tcodex, tpensadero)."""
    usuarios = instalado().get("ai_users", {})
    for u in quienes:
        if u not in usuarios:
            sys.exit(f"flota: {u} no es un usuario IA de fleet.toml ({', '.join(usuarios)})")
    lista = list(quienes) or list(usuarios)
    abrir = arranques()
    llenar = lambda texto: re.sub(r"@([a-z-]+)@", lambda m: binario(m.group(1)), texto)
    primero = None
    for u in lista:
        guion = llenar(LLAVE) if u in de_trabajo() else ""
        if u in abrir:
            sesion, ventana, carpeta, orden = abrir[u]
            guion += llenar(VENTANA.replace("@sesion@", sesion).replace("@ventana@", ventana)
                            .replace("@carpeta@", carpeta).replace("@orden@", shlex.quote(orden)))
            primero = primero or (u, f"{sesion}:{ventana}")
            a = usuarios[u]
            if "codex" in (a.get("providers") or [a.get("provider", "claude")]):
                # codex cannot keep a mailbox wait past its turn: the despertador wakes the
                # sessions that asked (buzon atento), from outside the sandbox, in the background
                guion += llenar(DESPERTADOR)
        elif u not in de_trabajo():
            continue
        else:
            print(TENUE(f"{u}: sin coord en fleet.toml, solo su llave"))
        subprocess.run(["sudo", "machinectl", "shell", f"{u}@", binario("bash"), "-lc", guion])
    if not primero:
        sys.exit("flota: nada que abrir: ninguno tiene coord ni es un pensadero")
    u, donde = primero
    os.execvp("sudo", ["sudo", "machinectl", "shell", f"{u}@", binario("tmux"), "attach", "-t", donde])


# ---- doing things: every step asks first ----------------------------------------

def coord_claude():
    """The claude AI user of the installed fleet.toml that has the role coord."""
    agentes = instalado().get("ai_users", {})
    return next((u for u, a in agentes.items()
                 if "claude" in a.get("providers", [a.get("provider")]) and "coord" in a.get("roles", [])), None)

PUSHURL = "/dev/null/no-push-fetch-only"     # how clonar.py and entregar-repo mark an agent's remote


def si(pregunta, defecto=False):
    """Ask on the terminal; Enter takes the default."""
    try:
        r = input(pregunta + (" [S/n] " if defecto else " [s/N] ")).strip().lower()
    except EOFError:
        return False
    return defecto if not r else r in ("s", "si", "sí", "y", "yes")


def git(repo, *args, capturar=True):
    if capturar:
        r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
        return r.returncode, r.stdout.strip()
    return subprocess.run(["git", "-C", repo, *args]).returncode, ""


def principal(repo):
    """Your clone's accepted branch: main, or master in a repo that keeps the old name
    (2026-10-20); None if it has neither."""
    for rama in ("main", "master"):
        if git(repo, "rev-parse", "--verify", "-q", f"refs/heads/{rama}")[0] == 0:
            return rama
    return None


def remotos_de_agentes(repo):
    """{remote: name of the repo in the agent's ~/work} for the agents' fetch-only remotes."""
    out = {}
    rc, txt = git(repo, "config", "--get-regexp", r"^remote\..*\.pushurl$")
    for linea in txt.splitlines():
        clave, _, valor = linea.partition(" ")
        if valor == PUSHURL:
            remoto = clave[len("remote."):-len(".pushurl")]
            _, url = git(repo, "config", f"remote.{remoto}.url")
            # its path under the agent's ~/work: a repo, or <group>/<repo>
            m = re.search(r"/work/(.+?)/*$", url)
            out[remoto] = m.group(1) if m else os.path.basename(repo)
    return out


def ramas_nuevas(repo, remoto, base="main"):
    """The agent's branches not in your main (or master), fewest new commits first (a
    branch stacked on another comes after it)."""
    rc, txt = git(repo, "branch", "-r", "--no-merged", base, "--list", f"{remoto}/*")
    ramas = [r.strip() for r in txt.splitlines()
             if r.strip() and "->" not in r and not r.strip().endswith(("/main", "/master", "/HEAD"))]
    def adelante(r):
        return int(git(repo, "rev-list", "--count", f"{base}..{r}")[1] or 0)
    return sorted(ramas, key=adelante)


def revisar(repo, rama, base="main"):
    """Show a branch: its commits, the files it touches, then the whole diff in a pager."""
    banda(f"{corto(repo)}: {rama}")
    print()
    print(TITULO("  commits:"))
    print("  " + git(repo, "log", "--oneline", "--no-decorate", f"{base}..{rama}")[1].replace("\n", "\n  "))
    print(TITULO("\n  archivos:"))
    print("  " + git(repo, "diff", "--stat", f"{base}...{rama}")[1].replace("\n", "\n  "))
    print()
    if si("  ¿Ver el diff completo? (q para salir del visor)"):
        env = dict(os.environ, LESS=os.environ.get("LESS", "-R"))
        subprocess.run(["git", "-C", repo, "-c", "color.ui=always", "diff", f"{base}...{rama}"], env=env)


