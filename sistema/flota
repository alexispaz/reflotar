def carpetas_que_sobran(origen, destino, sobran):
    """The folders under destino that origen lacks and that hold nothing once `sobran`
    (the files --borrar deletes) are gone, deepest first; never in a .git. A folder
    with anything else in it stays, and rsync deletes a folder only when it is empty."""
    borra, fuera = {r for r, _ in sobran}, set()
    for raiz, dirs, archivos in os.walk(destino, topdown=False):
        rel = os.path.relpath(raiz, destino)
        if rel == "." or ".git" in rel.split(os.sep) or os.path.lexists(os.path.join(origen, rel)):
            continue
        if all(os.path.join(rel, x) in borra for x in archivos) and \
           all(os.path.join(rel, x) in fuera for x in dirs):
            fuera.add(rel)
    return sorted(fuera, key=lambda r: (-r.count(os.sep), r))


def borrar_en(u, de, a, viene, archivos, carpetas):
    """Delete at the destination exactly the listed paths, none of which is at the origin:
    rsync --delete-missing-args turns each into a deletion, and a folder only when empty.
    Files first, then folders a level at a time, deepest first (rsync sorts its list).
    That the paths and their folders are missing at the origin is the point, so its
    "vanished" and "parent dir is absent" notes are not shown, nor its exit 24."""
    import tempfile
    tandas = [archivos] + [[c for c in carpetas if c.count(os.sep) == n]
                           for n in sorted({c.count(os.sep) for c in carpetas}, reverse=True)]
    mal = []
    for tanda in (t for t in tandas if t):
        with tempfile.NamedTemporaryFile("w", suffix=".lista", delete=False) as f:
            f.write("".join(rel + "\n" for rel in tanda))
            lista = f.name
        try:
            rs = ["rsync", "-a", "--delete-missing-args", f"--files-from={lista}", de + "/"]
            rs += [a + "/"] if viene else ["-e", RSH, f"{u}:{a}/"]
            r = subprocess.run(rs, stderr=subprocess.PIPE, text=True)
        finally:
            os.unlink(lista)
        otras = [l for l in r.stderr.splitlines()
                 if not re.search(r"file has vanished|parent dir is absent|some files vanished", l)]
        sys.stderr.write("".join(l + "\n" for l in otras))
        if r.returncode not in (0, 24) or otras:
            mal.append(r.returncode)
    print(AVISO(f"  rsync, al borrar: salió con {mal}") if mal else
          OK(f"  borrados: {len(archivos)} archivo(s)" + (f", {len(carpetas)} carpeta(s)" if carpetas else "")))


def pasar(origen, destino, borrar=False, arbol=None):
    """flota pasar: rsync, one way, between you and the AI users or between them. As cp,
    a destination folder that exists gets the thing inside it, unless it bears the
    origin's name: then it is the copy, brought up to date. Several origins, or --arbol,
    go inside the destination, which is then always a folder. Shown first, then asked."""
    if isinstance(origen, list) and len(origen) == 1 and not arbol:
        origen = origen[0]
    if isinstance(origen, list) or arbol:
        return pasar_varios(origen if isinstance(origen, list) else [origen], destino, borrar, arbol)
    u_o, _, src = lugar(origen)
    u_d, base, dst = lugar(destino)
    lados(u_o, u_d)
    if not os.path.exists(src):
        sys.exit(f"flota: {src} does not exist")
    con_repos(src, origen, u_o, u_d)
    archivo = os.path.isfile(src)
    carpeta = destino.endswith("/") or (archivo and not os.path.exists(dst))   # a folder to put it in
    adentro = (carpeta or os.path.isdir(dst)) and os.path.basename(dst) != os.path.basename(src)
    final = os.path.join(dst, os.path.basename(src)) if adentro else dst
    if archivo and os.path.basename(final) != os.path.basename(src):
        sys.exit("flota: a file keeps its name: give a folder as the destination")
    if u_d:
        dentro(final, base)
    confidencial(u_o, u_d, [src])
    origen_rs = src if archivo else src + "/"
    hacia = os.path.dirname(final) + "/" if archivo else final + "/"
    rsync_y_preguntar([origen_rs], hacia, u_d, borrar, [],
                      [f"{src}  ->  {(u_d + ':') if u_d else ''}{final}"],
                      os.path.dirname(final) if archivo else final)


def pasar_varios(origenes, destino, borrar, arbol):
    """Several origins into one destination folder, each by its name; with --arbol RAIZ,
    each at its path under RAIZ (rsync -R), so folders from different points of a tree
    land at the same points of the copy."""
    lugares = [lugar(o) for o in origenes]
    u_o = lugares[0][0]
    if any(l[0] != u_o for l in lugares):
        sys.exit("flota: the origins are all yours, or all of one AI user")
    u_d, base, dst = lugar(destino)
    lados(u_o, u_d)
    if u_d:
        dentro(dst, base, raiz_ok=True)
    srcs = [l[2] for l in lugares]
    for src, o in zip(srcs, origenes):
        if not os.path.exists(src):
            sys.exit(f"flota: {src} does not exist")
        con_repos(src, o, u_o, u_d)
    if arbol:
        u_r, _, raiz = lugar(arbol)
        if u_r != u_o:
            sys.exit("flota: --arbol is on the same side as the origins")
        rels = [os.path.relpath(src, raiz) for src in srcs]
        if any(r == "." or r.startswith("..") for r in rels):
            sys.exit(f"flota: every origin goes inside --arbol {raiz}")
        envio = [f"{raiz}/./{r}" for r in rels]                    # -R keeps what follows /./
        llegan = [os.path.join(dst, r) for r in rels]
    else:
        nombres = [os.path.basename(src) for src in srcs]
        if len(set(nombres)) < len(nombres):
            sys.exit("flota: two origins have the same name; with --arbol each keeps its path")
        envio = srcs
        llegan = [os.path.join(dst, n) for n in nombres]
    confidencial(u_o, u_d, srcs)
    rsync_y_preguntar(envio, dst + "/", u_d, borrar, ["--relative"] if arbol else [],
                      [f"{s}  ->  {(u_d + ':') if u_d else ''}{l}" for s, l in zip(srcs, llegan)], dst)


def con_repos(src, origen, u_o, u_d):
    """A folder with repos goes by flota pasar ORIGEN alone (repos by git, to their one
    fleet), and never from one fleet to another: that is flota mover."""
    if os.path.isdir(src) and tiene_repos(src):
        if u_o and u_d:
            sys.exit(f"flota: {src} tiene repos, y un proyecto vive en una sola flota: "
                     f"para pasárselo a {u_d}, flota mover {origen} {u_d}")
        if u_o:                                         # from its fleet: to your copy, same path
            rel = os.path.relpath(src, f"{CASAS}/{u_o}/work")
            sys.exit(f"flota: {src} tiene repos, y un proyecto viene a tu copia en el mismo camino: "
                     f"flota pasar {u_o}:{rel} ~/agents/{rel}")
        rel = os.path.relpath(os.path.realpath(src), os.path.realpath(CLONES))
        if rel.startswith(".."):
            sys.exit(f"flota: {src} tiene repos, y un proyecto con repos va entre su flota y tu copia en "
                     f"{CLONES}, en el mismo camino: movelo a {CLONES}/{os.path.basename(src)} y, "
                     f"parado ahí, flota pasar . {u_d}")
        sys.exit(f"flota: {src} tiene repos, y un proyecto va al mismo camino en su flota: "
                 f"parado en {corto(src)}, flota pasar . {hacia}")


