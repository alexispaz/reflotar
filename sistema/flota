def tiene_repos(ruta):
    """Whether a folder is a git repo or holds one, at any depth."""
    if os.path.isdir(os.path.join(ruta, ".git")):
        return True
    for d, dirs, _ in os.walk(ruta):
        if ".git" in dirs:
            return True
    return False


def como_proyecto(origen, destino):
    """(the place pasar_proyecto takes, the fleet named) when origin and destination are
    the two copies of one project: a folder of yours under ~/agents and a fleet, bare
    (`flota pasar . pensadero`, `flota pasar pensadero .`) or as <fleet>:<the same
    path>. None for anything else (a file or folder to a place you name)."""
    usuarios = instalado().get("ai_users", {})
    def mio(x):
        if x in usuarios or (x.partition(":")[0] in usuarios and ":" in x):
            return None
        r = os.path.relpath(os.path.realpath(os.path.expanduser(x)), os.path.realpath(CLONES))
        return None if r == "." or r.startswith("..") else r
    def flota(x, rel):
        u, sep, r = x.partition(":")
        if u not in usuarios:
            return None
        return u if not sep or r.strip("/") == rel else None
    rel = mio(origen)
    if rel is not None and flota(destino, rel):
        return os.path.realpath(os.path.expanduser(origen)), flota(destino, rel)   # yours, to its fleet
    rel = mio(destino)
    if rel is not None and flota(origen, rel):
        return f"{flota(origen, rel)}:{rel}", flota(origen, rel)    # from the fleet, to yours
    # <fleet>:<path> into the folder that holds your copy (`flota pasar pensadero:x .`
    # standing in ~/agents): the same two copies, said as cp would
    u, sep, r = origen.partition(":")
    r = r.strip("/")
    if u in usuarios and sep and r and destino not in usuarios and ":" not in destino:
        d = os.path.realpath(os.path.expanduser(destino))
        if os.path.isdir(d) and os.path.basename(r) != os.path.basename(d) and \
           os.path.relpath(os.path.join(d, os.path.basename(r)), os.path.realpath(CLONES)) == r:
            return f"{u}:{r}", u
    return None


def archivo_de_proyecto(texto, flota_pedida):
    """(origin, destination) for flota pasar when the two sides of a project name one
    file, not a folder: the file goes to the same folder on the other side, as a plain
    pasar (the project form compares folders, and found nothing in a file: 2026-11-16).
    None for a folder."""
    usuarios = instalado().get("ai_users", {})
    u, sep, rel = texto.partition(":")
    if u in usuarios and sep:                                      # from the fleet, to you
        rel = rel.strip("/")
        if not os.path.isfile(f"{CASAS}/{u}/work/{rel}"):
            return None
        return f"{u}:{rel}", os.path.join(CLONES, os.path.dirname(rel)) + "/"
    if not os.path.isfile(texto):
        return None
    dueno = par(os.path.dirname(texto), flota_pedida)[0]
    if flota_pedida and dueno != flota_pedida:
        sys.exit(f"flota: {corto(os.path.dirname(texto))} es de {dueno}, y un proyecto vive en una sola flota")
    rel = os.path.relpath(texto, os.path.realpath(CLONES))
    return texto, f"{dueno}:{os.path.dirname(rel)}/"


def pasar_proyecto(texto, borrar=False, flota_pedida=None):
    """flota pasar between the two copies of a project (a project lives in one fleet):
    `.` or ~/agents/<path> goes to its fleet, <fleet>:<path> comes to ~/agents/<path>.
    Its repos travel by git (entregar-repo; your review and merge, or a safe clone, as
    flota traer and flota clonar); everything else by rsync, never a file git follows
    on either side, never over a newer one (--update). With --borrar, and only in a
    folder with no repos in it (one inside a repo is fine), it also deletes the loose
    files only the destination has, listed first. One summary, one question."""
    usuarios = instalado().get("ai_users", {})
    viene = texto.partition(":")[0] in usuarios and ":" in texto      # from the fleet to you
    if flota_pedida and not viene:
        dueno, mia_ = par(texto, flota_pedida)[:2]
        if dueno != flota_pedida:
            sys.exit(f"flota: {corto(mia_)} es de {dueno}, y un proyecto vive en una sola "
                     f"flota: para pasárselo a {flota_pedida}, flota mover {dueno}:{corto(mia_)} {flota_pedida}")
    u, mia, suya, filas, d, sin_clon = estado_carpeta(texto, viene=viene,
                                                      nueva=None if viene else flota_pedida)
    if borrar and (filas or sin_clon):
        sys.exit("flota: --borrar solo en una carpeta sin repos adentro, y "
                 f"{corto(mia)} tiene: " + ", ".join([n for n, *_ in filas] + sin_clon)
                 + ". Pasá sin --borrar, o una subcarpeta sin repos")
    sobran = (d["solo_aca"] if viene else d["solo_alla"]) if borrar else []
    vacias = carpetas_que_sobran(suya if viene else mia, mia if viene else suya, sobran) if borrar else []
    if viene:
