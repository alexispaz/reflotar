def como(agente, *cmd):
    return correr(["sudo", "-u", agente, "-H", *cmd], cwd="/")   # it cannot enter your folder


def tmux(agente, *args):
    return como(agente, binario("tmux"), *args)


def ppid(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            return int(f.read().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def panel_de(pid, paneles):
    """The tmux pane a process runs in: its own, or one of its ancestors'."""
    while pid > 1:
        if pid in paneles:
            return paneles[pid]
        pid = ppid(pid)
    return None


def borrador(agente, panel, prompt="\u276f"):
    """What waits in the session's window: text typed and not sent, or a menu's choice
    (a dimmed suggestion does not count). claude's prompt is ❯, codex's › (U+203A)."""
    rc, out, _ = tmux(agente, "capture-pane", "-e", "-p", "-t", panel)
    lineas = [l for l in out.splitlines() if prompt in l]
    if rc or not lineas:
        return None
    resto = lineas[-1].split(prompt, 1)[1]
    resto = re.sub(r"\x1b\[(?:3\d|39|0)?m", "", resto).replace("\xa0", " ").strip()
    if not resto or resto.startswith("\x1b[2m"):
        return None
    return re.sub(r"\x1b\[[0-9;]*m", "", resto)


def reiniciar(args):
    """flota reiniciar [--seguir] [--forzar] [USUARIO...] [SESIÓN...]: the claude and codex
    sessions of every AI user (the coordinator's user first), or of the users named, or
    only the sessions named."""
    seguir = "--seguir" in args
    forzar = "--forzar" in args
    resto = [a for a in args if a not in ("--seguir", "--forzar")]
    usuarios_cfg = instalado().get("ai_users", {})
    pedidos = [a for a in resto if a in usuarios_cfg]
    nombres = [a for a in resto if a not in usuarios_cfg]
    provee = lambda u: usuarios_cfg[u].get("providers") or [usuarios_cfg[u].get("provider", "claude")]
    coord = coord_claude()
    usuarios = sorted(pedidos or usuarios_cfg, key=lambda u: u != coord)
    vistas = set()
    for u in usuarios:
        if "claude" in provee(u):
            vistas |= reiniciar_usuario(u, nombres, seguir, forzar)
        if "codex" in provee(u):
            vistas |= reiniciar_codex(u, nombres, seguir, forzar)
    faltan = set(nombres) - vistas
    if faltan:
        sys.exit(f"flota: ninguna sesión viva se llama {', '.join(sorted(faltan))}")


# What `flota reiniciar` asks a codex AI user, as that user: its live codex sessions on a
# terminal (pid, cwd, seconds running), and its rollouts' first line with their mtime.
CODEX_SH = r"""
cd /
ps -u "$(id -un)" -o pid=,comm=,tty=,etimes= | while read -r pid comm tty et; do
  [ "$comm" = codex ] && [ "$tty" != "?" ] && printf 'S|%s|%s|%s\n' "$pid" "$(readlink /proc/$pid/cwd)" "$et"
done
ls -t "$HOME"/.codex/sessions/*/*/*/rollout-*.jsonl 2>/dev/null | head -300 | while read -r f; do
  printf 'R|%s|' "$(stat -c %Y "$f")"; head -n 1 "$f" | head -c 20000; echo
done
[ -f "$HOME/.codex/session_index.jsonl" ] && tail -n 5000 "$HOME/.codex/session_index.jsonl" | sed 's/^/N|/'
true
"""


def _buscar(d, clave):
    """The first value of clave anywhere in a JSON object (codex nests session_meta)."""
    if isinstance(d, dict):
        if isinstance(d.get(clave), str):
            return d[clave]
        for v in d.values():
            r = _buscar(v, clave)
            if r:
                return r
    elif isinstance(d, list):
        for v in d:
            r = _buscar(v, clave)
            if r:
                return r
    return None


def sesiones_codex(agente, paneles=None):
    """[{session, pid, cwd, thread, idle_minutes}] of an AI user's live codex sessions on
    a terminal. A session's thread is the one whose name is the session's (its window's:
    conventions rule 6; codex keeps names in ~/.codex/session_index.jsonl, the newest
    entry winning), when paneles (tmux's, by pid) gives its window and exactly one thread
    has that name. Else,
    the newest rollout whose cwd is the session's (codex keeps no rollout open: the
    aparejador, 2026-11-09); two in one folder share no thread: neither gets one."""
    rc, out, err = como(agente, "sh", "-c", CODEX_SH)
    if rc:
        print(AVISO(f"flota: no pude preguntarle a {agente}: {(err.strip().splitlines() or ['?'])[-1]}"))
        return []
    vivas, rollouts, mtimes, nombre_de = [], {}, {}, {}
    for l in out.splitlines():
        if l.startswith("N|"):
            try:
                e = json.loads(l[2:])
            except ValueError:
                continue
            if isinstance(e, dict) and isinstance(e.get("id"), str) and isinstance(e.get("thread_name"), str):
                nombre_de[e["id"]] = e["thread_name"].strip()          # append-only: the last wins
            continue
        partes = l.split("|", 2) if l.startswith("R|") else l.split("|")
        if partes[0] == "S" and len(partes) == 4:
            vivas.append({"pid": int(partes[1]), "cwd": partes[2]})
        elif partes[0] == "R" and len(partes) == 3:
            try:
                meta = json.loads(partes[2])
            except ValueError:
                continue
            cwd, tid = _buscar(meta, "cwd"), _buscar(meta, "id")
            if cwd and tid and re.fullmatch(r"[A-Za-z0-9-]+", tid):
                mtimes.setdefault(tid, int(partes[1]))
                if cwd not in rollouts:
                    rollouts[cwd] = (tid, int(partes[1]))      # ls -t: the first is the newest
    hilos_de = {}
    for tid, n in nombre_de.items():
        if re.fullmatch(r"[A-Za-z0-9-]+", tid):
            hilos_de.setdefault(n, []).append(tid)
    por_carpeta = {}
    for v in vivas:
        por_carpeta.setdefault(v["cwd"], []).append(v)
    for v in vivas:
        tid, mtime = rollouts.get(v["cwd"], (None, None))
        v["thread"] = tid if len(por_carpeta[v["cwd"]]) == 1 else None
        donde = panel_de(v["pid"], paneles) if paneles else None
        por_nombre = hilos_de.get(donde[1].split(":", 1)[1], []) if donde else []
        if len(por_nombre) == 1:                               # its name says which
            v["thread"], mtime = por_nombre[0], mtimes.get(por_nombre[0])
        v["idle_minutes"] = int((time.time() - mtime) // 60) if mtime else None
    return vivas


def reiniciar_codex(agente, nombres, seguir, forzar):
    """Restart the codex sessions of one AI user (those named, if any), as claude's are:
    shown, asked, /exit typed in their window, started again there (`codex "<aviso>"`,
    or `codex resume <thread>` with --seguir). The names it has (the windows')."""
    humano = instalado().get("human", {}).get("name") or "tu humano"
    rc, out, _ = tmux(agente, "list-panes", "-a", "-F", "#{pane_pid} #{pane_id} #{session_name}:#{window_name}")
    paneles = {int(l.split()[0]): l.split()[1:] for l in out.splitlines() if l.strip()}
    sesiones = sesiones_codex(agente, paneles)
    if not sesiones:
        sin_sesiones(agente, "codex")
        return set()
    for s_ in sesiones:
        donde = panel_de(s_["pid"], paneles)
        s_["donde"] = donde
        s_["session"] = donde[1].split(":", 1)[1] if donde else os.path.basename(s_["cwd"])
    tiene = {s_["session"] for s_ in sesiones}
    if nombres:
        sesiones = [s_ for s_ in sesiones if s_["session"] in nombres]
    if not sesiones:
        return tiene
    sesiones.sort(key=lambda s_: (s_["session"] != "coord", s_["session"]))
    banda(f"reiniciar sesiones de codex de {agente}: " + ("la misma conversación" if seguir else "de cero"))
    for s_ in sesiones:
        nombre, pid, donde = s_["session"], s_["pid"], s_["donde"]
        print()
        print(TITULO(f"  {nombre}") + TENUE(f"  {donde[1] if donde else 'sin ventana'}  ·  "
              + (f"quieta hace {s_['idle_minutes']} min" if s_["idle_minutes"] is not None else "quieta ¿?")
              + (f"  ·  {s_['thread']}" if s_["thread"] else "")))
        if not donde:
            print(AVISO("    no la encuentro en tmux: la dejo"))
            continue
        if s_["idle_minutes"] is None or s_["idle_minutes"] < 2:
            if not forzar:
                print(AVISO("    está trabajando, o no sé desde cuándo está quieta: la dejo (o con --forzar)"))
                continue
        if seguir and not s_["thread"]:
            print(AVISO("    no sé cuál es su conversación (¿dos sesiones en la misma carpeta?): la dejo"))
            continue
        texto = borrador(agente, donde[0], prompt="\u203a")
        if texto:
            print(AVISO(f"    algo espera en su ventana ({texto[:40]!r}): la dejo; resolvelo antes"))
            continue
        if not si(f"    ¿Reinicio {nombre}?"):
            continue
        propio = pid in paneles
        if propio:
            tmux(agente, "set-option", "-p", "-t", donde[0], "remain-on-exit", "on")
        tmux(agente, "send-keys", "-t", donde[0], "-l", "/exit")
        tmux(agente, "send-keys", "-t", donde[0], "Enter")
        for _ in range(120):
            if not os.path.exists(f"/proc/{pid}"):
                break
            time.sleep(0.5)
        else:
            print(AVISO(f"    no salió en un minuto: miralo en {donde[1]}. Si muestra una pregunta "
                        "(cerrar con tareas programadas, por ejemplo), contestala vos: sí la cierra, "
                        "no la deja como estaba"))
            if propio:
                tmux(agente, "set-option", "-p", "-u", "-t", donde[0], "remain-on-exit")
            continue
        cmd = (["codex", "resume", s_["thread"], SEGUIDA.format(humano=humano)] if seguir
               else ["codex", NUEVA.format(humano=humano)])
        linea = "cd " + shlex.quote(s_["cwd"]) + " && " + " ".join(map(shlex.quote, cmd))
        if propio:
            tmux(agente, "respawn-pane", "-t", donde[0], "-c", s_["cwd"], linea)
            tmux(agente, "set-option", "-p", "-u", "-t", donde[0], "remain-on-exit")
        else:
            tmux(agente, "send-keys", "-t", donde[0], "-l", linea)
            tmux(agente, "send-keys", "-t", donde[0], "Enter")
        print(OK(f"    reiniciada en {donde[1]}")
              + ("" if seguir or not s_["thread"] else TENUE(f"  (la conversación anterior: codex resume {s_['thread']})")))
    return tiene


