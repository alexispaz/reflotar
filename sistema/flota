def par(texto, nueva=None):
    """(AI user, your folder, its folder) for a place: `.` or a path of yours under
    ~/agents (its fleet deduced), or <user>:<path> (your side is ~/agents/<path>).
    nueva: the fleet you named, for a project no fleet has yet."""
    usuarios = instalado().get("ai_users", {})
    u, sep, rel = texto.partition(":")
    if u in usuarios and sep:
        rel = rel.strip("/")
        if not rel or ".." in rel.split("/"):
            sys.exit(f"flota: {texto}: name a folder inside its ~/work")
        return u, os.path.join(CLONES, rel), f"{CASAS}/{u}/work/{rel}"
    mia = os.path.realpath(os.path.expanduser(texto))
    rel = os.path.relpath(mia, os.path.realpath(CLONES))
    if rel == "." or rel.startswith(".."):
        sys.exit(f"flota: {mia} is not a folder inside {CLONES}: say whose it is, <user>:<path>")
    # the fleet: whoever has this path, or the nearest folder above it (a subfolder may be
    # new there), or the repos in it or around it
    tienen, arriba = [], rel
    while arriba and not tienen:
        tienen = [u for u in usuarios if os.path.isdir(f"{CASAS}/{u}/work/{arriba}")]
        arriba = os.path.dirname(arriba)
    lista = clones(mia) or ([raiz_de(mia)] if raiz_de(mia) != mia else [])
    repos, _ = duenos(lista) if lista else ({}, [])
    tienen = sorted(set(tienen) | set(repos)) or ([nueva] if nueva else [])
    if not tienen:
        sys.exit(f"flota: no fleet has {rel} yet: name it, <user>:{rel}")
    if len(tienen) > 1:
        sys.exit(f"flota: {rel} is in {' and '.join(tienen)}: a project lives in one fleet. "
                 f"Name one ({tienen[0]}:{rel}), or leave one with flota mover")
    return tienen[0], mia, f"{CASAS}/{tienen[0]}/work/{rel}"


def seguidos(mia, u):
    """Paths (relative to mia) that git follows in its repos: your main, and every
    branch of u's you have fetched. Your clone answers; the agent's repo is not run."""
    out = set()
    raiz = raiz_de(mia)
    if raiz != mia:                                   # a subfolder of a repo: its tracked paths too
        dentro = os.path.relpath(mia, raiz) + "/"
        for ref in [principal(raiz) or "HEAD"] + [r for r in git(raiz, "for-each-ref", "--format=%(refname:short)",
                                                                   f"refs/remotes/{u}/")[1].split() if r]:
            rc, txt = git(raiz, "ls-tree", "-r", "--name-only", ref, "--", dentro)
            if rc == 0:
                out |= {l[len(dentro):] for l in txt.splitlines() if l.startswith(dentro)}
    for repo in clones(mia):
        pre = os.path.relpath(repo, mia)
        pre = "" if pre == "." else pre + "/"
        refs = [principal(repo) or "HEAD"] + [r for r in git(repo, "for-each-ref", "--format=%(refname:short)",
                                                               f"refs/remotes/{u}/")[1].split() if r]
        for ref in refs:
            rc, txt = git(repo, "ls-tree", "-r", "--name-only", ref)
            if rc == 0:
                out |= {pre + l for l in txt.splitlines() if l}
    return out


# What an AI user's copy must be: readable by its group (the human is in it), whatever
# mode the origin had; a file of the human's kept at 600 would otherwise come back
# unreadable to them (2026-11-16).
LEGIBLE = "--chmod=Dg+rx,Fg+r"


def de_sesion(rel):
    """A session's own working file, never the project's: a lock under .claude/."""
    partes = rel.split("/")
    return len(partes) >= 2 and partes[-2] == ".claude" and partes[-1].endswith(".lock")


def arbol(raiz, fuera):
    """{relative path: (size, mtime)} of the files under raiz, outside every .git, every
    repo's tracked files (fuera) and the folders that could not be read (listed apart)."""
    archivos, ilegibles = {}, []
    def error(e):
        ilegibles.append(os.path.relpath(e.filename, raiz))
    for d, dirs, fs in os.walk(raiz, onerror=error):
        dirs[:] = sorted(x for x in dirs if x != ".git")
        for f in fs:
            if f == ".git":
                continue
            ruta = os.path.join(d, f)
            rel = os.path.relpath(ruta, raiz)
            if rel in fuera or de_sesion(rel):
                continue
            try:
                st = os.lstat(ruta)
            except OSError:
                ilegibles.append(rel)
                continue
            archivos[rel] = (st.st_size, int(st.st_mtime))
    return archivos, ilegibles


def sueltos(mia, suya, fuera):
    """How the loose files of the two sides differ, as rsync's quick check sees it
    (size and modification time): only here, only there, newer here, newer there."""
    aca, ilegibles_aca = arbol(mia, fuera) if os.path.isdir(mia) else ({}, [])
    alla, ilegibles_alla = arbol(suya, fuera) if os.path.isdir(suya) else ({}, [])
    d = {"solo_aca": [], "solo_alla": [], "nuevo_aca": [], "nuevo_alla": []}
    for rel in sorted(set(aca) | set(alla)):
        a, b = aca.get(rel), alla.get(rel)
        if a and not b:
            d["solo_aca"].append((rel, a[0]))
        elif b and not a:
            d["solo_alla"].append((rel, b[0]))
        elif a != b:
            d["nuevo_aca" if a[1] >= b[1] else "nuevo_alla"].append((rel, max(a[0], b[0])))
    d["ilegibles"] = ilegibles_aca + ilegibles_alla
    return d


def resumen_repos(mia, u, traer_antes=True):
    """For each repo in mia: the branches of u's not in your main (after a fetch, unless
    traer_antes is False), and how many commits of your main u has not got."""
    filas = []
    for repo in clones(mia):
        nombre = os.path.relpath(repo, mia)
        nombre = os.path.basename(repo) if nombre == "." else nombre
        remotos = remotos_de_agentes(repo)
        if u not in remotos:
            filas.append((nombre, None, None, f"{u} no lo tiene"))
            continue
        if traer_antes:
            git(repo, "fetch", "-q", u)
        base = principal(repo) or "HEAD"
        ramas = [(r, int(git(repo, "rev-list", "--count", f"{base}..{r}")[1] or 0))
                 for r in ramas_nuevas(repo, u, base)]
        falta = int(git(repo, "rev-list", "--count", base, "--not", f"--remotes={u}/*")[1] or 0)
        filas.append((nombre, ramas, falta, None))
    return filas


def tamano(n):
    for u, f in (("GB", 1 << 30), ("MB", 1 << 20), ("kB", 1 << 10)):
        if n >= f:
            return f"{n / f:.1f} {u}".replace(".", ",")
    return f"{n} B"


def estado_carpeta(texto, traer_antes=True, viene=None, nueva=None):
    """flota estado <carpeta>: your copy against the fleet's, changing nothing in either
    (the fetch only updates what your clone knows of the agent's branches)."""
    u, mia, suya = par(texto, nueva)
    flecha = "↔" if viene is None else ("←" if viene else "→")      # estado compares; pasar goes one way
    print(TITULO(f"{corto(mia)}  {flecha}  {u}:{os.path.relpath(suya, f'{CASAS}/{u}/work')}"
                 + ("" if viene is None else TENUE("   (" + (f"de {u} a vos" if viene else f"de vos a {u}") + ")"))))
    filas = resumen_repos(mia, u, traer_antes)
    repos_alla = sorted(os.path.relpath(os.path.dirname(g), suya)
                        for g in glob.glob(os.path.join(suya, "**", ".git"), recursive=True))
    sin_clon = [r for r in repos_alla if not os.path.isdir(os.path.join(mia, r, ".git"))]
    if filas or sin_clon:
        print(TITULO(f"  repos: {len(filas) + len(sin_clon)}"))
    for nombre, ramas, falta, nota in filas:
        if nota:
            print(f"    {nombre}: " + AVISO(nota))
            continue
        partes = [f"{len(ramas)} rama(s) para traer (" + ", ".join(f"{r.split('/', 1)[1]} +{n}" for r, n in ramas) + ")"
                  if ramas else "nada para traer"]
        if falta:
            partes.append(f"tu main tiene {falta} commit(s) que {u} no tiene")
        print(f"    {nombre}: " + "; ".join(partes))
    for r in sin_clon:
        print(f"    {r}: " + AVISO(f"está en {u} y no tenés clon (flota clonar {u} {r})"))
    d = sueltos(mia, suya, seguidos(mia, u))
    total = sum(len(d[k]) for k in ("solo_aca", "solo_alla", "nuevo_aca", "nuevo_alla"))
    if not total:
        print(OK("  archivos sueltos: iguales") if os.path.isdir(suya) and os.path.isdir(mia)
              else TENUE("  archivos sueltos: ninguno"))
    else:
        print(TITULO(f"  archivos sueltos que difieren: {total}"))
        for clave, texto_ in (("solo_aca", "solo tuyos"), ("nuevo_aca", "más nuevos acá"),
                              ("solo_alla", f"solo en {u}"), ("nuevo_alla", f"más nuevos en {u}")):
            if d[clave]:
                peso = sum(n for _, n in d[clave])
                print(f"    {len(d[clave]):>5} {texto_}  ({tamano(peso)})")
                for rel, n in d[clave][:5]:
                    print(TENUE(f"            {rel}") + (AVISO(f"  {tamano(n)}") if n >= GRANDE else ""))
                if len(d[clave]) > 5:
                    print(TENUE(f"            … y {len(d[clave]) - 5} más"))
        grandes = [(r, n) for k in ("solo_aca", "solo_alla", "nuevo_aca", "nuevo_alla") for r, n in d[k] if n >= GRANDE]
        if grandes:
            print(AVISO(f"    {len(grandes)} de más de 1 GB: " + ", ".join(r for r, _ in grandes[:5])))
    if d["ilegibles"]:
        print(AVISO(f"  no pude leer {len(d['ilegibles'])}: " + ", ".join(d["ilegibles"][:5])))
    return u, mia, suya, filas, d, sin_clon


# ---- flota mover --------------------------------------------------------------------
# A folder (a repo, a group of repos, or plain files) goes from one AI user to another,
# and the origin goes to that AI user's TRASH, with a line in TRASH/README.md: nothing
# is deleted. Repos keep their history in your clones under
# ~/agents. Anything that could be lost stops it before it starts.

def papelera(u):
    """Where mover leaves what it took out of u: its ~/work/TRASH, a plain folder."""
    return f"{CASAS}/{u}/work/TRASH"


def repos_en(src):
    """(repos, odd): src itself if it is a repo, else the repos directly inside it; odd
    holds what mover will not handle: a repo deeper down, a .git that is a file (a
    submodule or a worktree), a folder you cannot read."""
    if os.path.isdir(os.path.join(src, ".git")):
        return [src], []
    repos, raros = [], []
    for d, carpetas, archivos in os.walk(src, onerror=lambda e: raros.append(f"no puedo leer {e.filename}")):
        if ".git" in archivos:
            raros.append(f"{d}: su .git es un archivo (submódulo o worktree)")
        if ".git" in carpetas:
            (repos if os.path.dirname(d) == src else raros).append(
                d if os.path.dirname(d) == src else f"{d}: un repo más adentro que el primer nivel")
            carpetas[:] = []
    return sorted(repos), raros


def problemas_del_repo(u, repo, clon=None):
    """What would be lost if repo left u's ~/work now. git runs as u, in u's repo. With
    your clone (fetched just before), everything u has must be in your clone's main:
    the agent need not have a main of its own, it gets yours as <you>/main. Without one,
    its own main is what gets cloned, so its branches must be in it."""
    g = binario("git")
    def de(*args):
        rc, out, _ = como(u, g, "-C", repo, *args)
        return out.strip() if rc == 0 else None
    p = []
    sucio = de("status", "--porcelain")
    if sucio is None or sucio:
        p.append(f"tiene cambios sin commitear ({len(sucio.splitlines()) if sucio else '?'} archivo/s)")
    if de("stash", "list"):
        p.append("tiene un stash guardado")
    ramas = [l.split() for l in (de("for-each-ref", "--format=%(refname:short) %(objectname)",
                                    "refs/heads") or "").splitlines() if l.strip()]
    if de("symbolic-ref", "-q", "HEAD") is None:              # detached: a commit of no branch
        ramas.append(["HEAD", de("rev-parse", "HEAD") or "?"])
    if clon:
        base = principal(clon) or "main"
        for rama, sha in ramas:
            if git(clon, "merge-base", "--is-ancestor", sha, base)[0] != 0:
                p.append(f"{rama} tiene commits que no están en tu {base} ({clon}): flota traer {clon}")
        return p
    base = next((b for b in ("main", "master") if b in (r for r, _ in ramas)), None)
    if not base:
        p.append("no tiene main (ni master), y no tenés un clon suyo: clonalo (flota clonar), "
                 "aceptá su rama (git switch -c main) y volvé a correr mover")
        return p
    for rama, _ in ramas:
        if rama not in (base, "HEAD"):
            n = de("rev-list", "--count", f"{base}..{rama}")
            if n != "0":
                p.append(f"la rama {rama} tiene {n or '?'} commit(s) que no están en su main: "
                         "clonalo (flota clonar) y traela (flota traer)")
    return p


def clon_de(u, repo):
    """Your clone whose remote u reads repo, or None."""
    for clon in clones():
        for remoto, nombre in remotos_de_agentes(clon).items():
            if remoto == u and f"{CASAS}/{u}/work/{nombre}" == repo:
                return clon
    return None


# Every process of the AI user, with its folder: pid|name|cwd. Any process, not only the
# sessions on a terminal that `flota estado` lists: codex's daemon has no terminal, and
# a shell or a pdflatex working there would break as well (aparejador, 2026-10-20).
PROCESOS_SH = r"""
cd /
for p in $(ps -u "$(id -un)" -o pid=); do
  c=$(readlink "/proc/$p/cwd" 2>/dev/null) || continue
  printf '%s|%s|%s\n' "$p" "$(cat "/proc/$p/comm" 2>/dev/null)" "$c"
done
"""


def procesos_en(u, src):
    """u's processes, of any kind, whose folder is src or inside it; None if u's
    processes cannot be seen."""
    rc, out, _ = como(u, "sh", "-c", PROCESOS_SH)
    if rc != 0:
        return None
    return [f"{nombre} (pid {pid})" for pid, nombre, cwd in
            (l.split("|", 2) for l in out.splitlines() if l.count("|") >= 2)
            if cwd == src or cwd.startswith(src + "/")]


def ahora_local():
    """Now, in the human's time zone (fleet.toml), labelled."""
    import datetime, zoneinfo
    tz = instalado().get("human", {}).get("timezone") or "UTC"
    try:
        return datetime.datetime.now(zoneinfo.ZoneInfo(tz)), tz
    except (zoneinfo.ZoneInfoNotFoundError, ValueError):
        return datetime.datetime.now(datetime.timezone.utc), "UTC"


TRASH_LEEME = """# TRASH

Lo que `flota mover` sacó de esta carpeta. Nada se borra solo: es de {humano}, que lo
borra cuando quiere. Las sesiones no trabajan acá ni cambian nada.

Para borrar una entrada: `sudo -u {u} rm -rf {trash}/<carpeta>`, y su renglón de abajo.

"""


def mover(origen, destino):
    usuarios = instalado().get("ai_users", {})
    u_o, base_o, src = lugar(origen)
    u_d, base_d, dst = lugar(destino)
    if not u_o or not base_o or not u_d or not base_d:
        sys.exit("flota: mover va de un usuario IA a otro: flota mover codex:repo_clases pensadero")
    if u_o == u_d:
        sys.exit(f"flota: los dos lados son de {u_o}; dentro de un usuario IA, que lo mueva su sesión")
    if src == base_o or not os.path.isdir(src):
        sys.exit(f"flota: {src} no es una carpeta dentro de {base_o}")
    if os.path.realpath(src).startswith(papelera(u_o)):
        sys.exit(f"flota: {src} ya está en TRASH")
    adentro = os.path.isdir(dst)
    final = os.path.join(dst, os.path.basename(src)) if adentro else dst
    rel_d = os.path.relpath(final, base_d)
    rel_o = os.path.relpath(src, base_o)

    banda(f"MOVER {u_o}:{rel_o}  ->  {u_d}:{rel_d}")
    print()
    problemas = []
    if os.path.exists(final):
        problemas.append(f"{u_d}:{rel_d} ya existe")
    elif not os.path.isdir(os.path.dirname(final)):
        problemas.append(f"{os.path.dirname(final)} no existe en {u_d}")
    repos, raros = repos_en(src)
    problemas += raros
    abiertas = procesos_en(u_o, src)
    if abiertas is None:
        problemas.append(f"no pude ver los procesos de {u_o}")
    elif abiertas:
        problemas.append(f"hay procesos de {u_o} trabajando ahí: {', '.join(abiertas)}. "
                         "Cerralos primero (las sesiones, su daemon, un shell abierto en esa carpeta)")
    plan_clones = []                               # (repo, your clone, new?)
    for repo in repos:
        corto_r = os.path.relpath(repo, base_o)
        clon = clon_de(u_o, repo)
        if clon:
            print(TENUE(f"  {corto_r}: git fetch {u_o} en {clon}"))
            if git(clon, "fetch", "-q", u_o)[0] != 0:
                problemas.append(f"{corto_r}: no pude traer de {u_o} a {clon}")
        for p in problemas_del_repo(u_o, repo, clon):
            problemas.append(f"{corto_r}: {p}")
        if clon:
            plan_clones.append((repo, clon, False))
        else:
            nuevo = os.path.join(CLONES, corto_r)
            if os.path.exists(nuevo):
                problemas.append(f"{corto_r}: {nuevo} ya existe y no es un clon de su repo")
            plan_clones.append((repo, nuevo, True))
    if problemas:
        print(AVISO("  No muevo nada:"))
        for p in problemas:
            lineas = textwrap.wrap(p, ANCHO - 6, break_on_hyphens=False)
            print("    - " + "\n      ".join(lineas))
        sys.exit(1)

    trash = papelera(u_o)
    fecha, tz = ahora_local()
    nombre = f"{fecha:%Y-%m-%d}-{os.path.basename(src)}"
    n = 2
    while os.path.exists(os.path.join(trash, nombre)):
        nombre, n = f"{fecha:%Y-%m-%d}-{os.path.basename(src)}-{n}", n + 1

    print(TITULO("  Qué hago:"))
    for repo, clon, nuevo in plan_clones:
        print(f"    - {os.path.relpath(repo, base_o)}: " + (f"lo clono en {clon} (su historia queda con vos)"
              if nuevo else f"tu clon {clon} ya tiene todo su main"))
    for repo, clon, _ in plan_clones:
        print(f"    - le entrego tu main de {clon} a {u_d}")
    if src not in repos:
        print(f"    - lo que no es un repo, con rsync, a {u_d}:{rel_d}")
    print(f"    - lo de {u_o} va a {trash}/{nombre}, con un renglón en su README.md")
    if plan_clones:
        print(f"    - saco el remoto {u_o} de tus clones: apuntaba a lo que se mueve")
    if pensadero(u_o):
        print(AVISO(f"  {src} es del pensadero: confidencial, lo que pensás."))
    print()
    if not si("¿Lo muevo?"):
        sys.exit("flota: no moví nada")
    try:
        motivo = input("¿Por qué? Una línea para el README de TRASH (Enter: sin motivo): ").strip()
    except EOFError:
        motivo = ""

    # 1. your clones: the history stays with you
    for repo, clon, nuevo in plan_clones:
        if nuevo:
            rc, out, err = correr([sys.executable, os.path.join(AQUI, "sistema", "clonar.py"),
                                   u_o, os.path.relpath(repo, base_o), clon])
            if rc != 0 or subprocess.run(["bash", "-euc", out]).returncode != 0:
                sys.exit(f"flota: no pude clonar {repo} en {clon}: no moví nada más\n{err.strip()}")
    # 2. the destination
    excluir = ["--exclude=.git"] + [f"--exclude=/{os.path.relpath(r, src)}/" for r in repos if r != src]
    for repo, clon, _ in plan_clones:
        sub = os.path.relpath(repo, src)
        nombre_d = rel_d if sub == "." else f"{rel_d}/{sub}"
        if subprocess.run([os.path.join(AQUI, "sistema", "entregar-repo"), u_d, clon,
                           "--name", nombre_d, "--go"]).returncode != 0:
            sys.exit(f"flota: no pude entregarle {clon} a {u_d}: lo de {u_o} sigue en su lugar")
    if src not in repos:
        rs = ["rsync", "-a", "--no-owner", "--no-group", LEGIBLE, *excluir, "-e", RSH, src + "/", f"{u_d}:{final}/"]
        if subprocess.run(rs).returncode != 0:
            sys.exit(f"flota: rsync falló: lo de {u_o} sigue en su lugar; revisá {u_d}:{rel_d}")
    if not os.path.isdir(final):
        sys.exit(f"flota: no encuentro {final}: lo de {u_o} sigue en su lugar")
    # 3. the origin, to TRASH
    renglon = (f"- {fecha:%Y-%m-%d %H:%M} ({tz}): `{nombre}/` era `{src}`; pasó a `{u_d}:{rel_d}` "
               f"con `flota mover`" + (f". Motivo: {motivo}" if motivo else "") + ".")
    leeme = TRASH_LEEME.format(humano=instalado().get("human", {}).get("name", "tu humano"),
                               u=u_o, trash=trash)
    rc, _, err = como(u_o, "sh", "-c",
                      'mkdir -p "$1" && [ ! -e "$1/$2" ] && mv -T "$3" "$1/$2" '
                      '&& { [ -e "$1/README.md" ] || printf "%s" "$4" > "$1/README.md"; } '
                      '&& printf "%s\\n" "$5" >> "$1/README.md"',
                      "sh", trash, nombre, src, leeme, renglon)
    if rc != 0:
        sys.exit(f"flota: ya está en {u_d}, pero no pude llevar lo de {u_o} a TRASH: {err.strip()}")
    # 4. the old remote pointed at what moved
    for repo, clon, _ in plan_clones:
        git(clon, "remote", "remove", u_o)
    print(OK(f"\nMovido: {u_d}:{rel_d}. Lo de {u_o} está en {trash}/{nombre}."))


def cluster(nombre, agentes):
    """clusters/add-cluster for each working AI user with a box on that cluster in the
    installed fleet.toml (or the ones named): its plan first, then --go if you say so."""
    bloque = instalado().get("cluster", {}).get(nombre)
    if bloque is None:
        sys.exit(f"flota: no [cluster.{nombre}] in /home/agents/etc/fleet/fleet.toml")
    agentes = agentes or [u for u in de_trabajo() if u in bloque.get("box", {})]
    if not agentes:
        sys.exit(f"flota: no AI user has a box on {nombre} in fleet.toml")
    add = os.path.join(AQUI, "clusters", "add-cluster")
    peor = 0
    for u in agentes:
        banda(f"{nombre}: {u}")
        print()
        if subprocess.run([add, nombre, u]).returncode != 0:
            peor = 1
            continue
        if si(f"  ¿Lo aplico en {nombre} para {u}?", defecto=True):
            peor = peor or subprocess.run([add, nombre, u, "--go"]).returncode
    sys.exit(peor)


