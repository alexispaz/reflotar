def rsync_y_preguntar(envio, hacia, u_d, borrar, extra, cabecera, hasta):
    """One rsync for all: a dry run shows what changes, then asks, then copies. The
    folders the destination lacks are made (--mkpath), as whoever writes there."""
    rs = ["rsync", "-a", "--mkpath", "--no-owner", "--no-group", "--exclude=.git",
          "--exclude=.claude/*.lock", *([LEGIBLE] if u_d else []), "--itemize-changes",
          *extra, *(["--delete"] if borrar else []), *(["-e", RSH] if u_d else []),
          *envio, f"{u_d}:{hacia}" if u_d else hacia]           # you read the origin; only its writer is the AI user
    r = subprocess.run(rs[:1] + ["-n"] + rs[1:], capture_output=True, text=True)
    # rsync's own lines say what failed; its last one only says that something did
    errores = [l for l in r.stderr.splitlines() if l.strip() and not l.startswith("rsync error:")]
    if r.returncode == 23 and errores:                      # some files: the rest can go
        print(AVISO(f"  rsync no puede con {len(errores)} (quedan fuera):"))
        for l in errores[:10]:
            print(AVISO("    " + l))
        if len(errores) > 10:
            print(TENUE(f"    … y {len(errores) - 10} más"))
    elif r.returncode != 0:
        sys.exit("flota: rsync:\n  " + "\n  ".join((errores or r.stderr.strip().splitlines() or ["?"])[:10]))
    lineas = [l for l in r.stdout.splitlines() if l.strip()]
    crea = [l for l in lineas if l.startswith("created ")]                     # --mkpath's folders
    cambios = [l for l in lineas if l not in crea and not l.startswith(".d")]
    for c in cabecera:
        print(c)
    if any(" directories for " in l for l in crea):                           # more than the last one
        print(TENUE(f"  crea las carpetas que faltan hasta {hasta}"))
    if not cambios:
        print(OK("ya está igual: nada que pasar"))
        return
    for l in cambios[:40]:
        print("  " + (AVISO(l) if l.startswith("*deleting") else l))
    if len(cambios) > 40:
        print(TENUE(f"  … y {len(cambios) - 40} más"))
    borra = sum(1 for l in cambios if l.startswith("*deleting"))
    if not si(f"¿Paso {len(cambios) - borra} cambio(s)" + (f" y borro {borra}" if borra else "")
              + ("?" if borrar else "? (no borra nada)"), defecto=not borra):
        return
    fin = subprocess.run(rs, stderr=subprocess.PIPE, text=True)
    errores = [l for l in fin.stderr.splitlines() if l.strip() and not l.startswith("rsync error:")]
    if fin.returncode == 23 and errores:       # a dry run does not open files: told only now
        print(AVISO(f"  pasó lo demás; rsync no pudo con {len(errores)}:"))
        for l in errores[:10]:
            print(AVISO("    " + l))
        if len(errores) > 10:
            print(TENUE(f"    … y {len(errores) - 10} más"))
    elif errores:
        sys.stderr.write("".join(l + "\n" for l in errores))
    sys.exit(fin.returncode)


def entregar(agente, ruta, nombre=None):
    """One clone, or every repo in a folder of related repos, which the agent gets in
    a folder of the same name: ~/agents/rc/a -> ~/work/rc/a."""
    ruta = os.path.realpath(os.path.expanduser(ruta))
    lista = clones(ruta)
    grupo = None if lista == [ruta] else (nombre or os.path.basename(ruta))
    if grupo:
        print(f"{grupo}: {len(lista)} repos -> ~{agente}/work/{grupo}/: "
              + ", ".join(os.path.basename(r) for r in lista))
        if not si("¿Los entrego?", defecto=True):
            return
    peor = 0
    for repo in lista:
        extra = (["--name", f"{grupo}/{os.path.basename(repo)}"] if grupo
                 else ["--name", nombre] if nombre else [])
        r = subprocess.run([os.path.join(AQUI, "sistema", "entregar-repo"), agente, repo, *extra, "--go"])
        peor = peor or r.returncode
    sys.exit(peor)


# What `flota estado` asks each AI user, as that user (its own /proc and folders):
# S| a live session (claude or codex on a terminal): pid, program, folder, seconds alive
# F| a folder in ~/work: name, newest change (epoch) three levels down, and
#    "repo" if it is a git repository, "grupo" if repositories sit inside it
# C| codex's newest session file (its last activity)
ESTADO_SH = r"""
cd /
ps -u "$(id -un)" -o pid=,comm=,tty=,etimes= | while read -r pid comm tty et; do
  case $comm in claude|codex) [ "$tty" = "?" ] || printf 'S|%s|%s|%s|%s\n' "$pid" "$comm" "$(readlink /proc/$pid/cwd)" "$et" ;; esac
done
for d in "$HOME"/work/*/; do
  [ -d "$d" ] || continue
  t=$(find "$d" -maxdepth 3 -not -path '*/.git/*' -printf '%T@\n' 2>/dev/null | sort -n | tail -1)
  g=""; [ -e "$d.git" ] && g=repo
  [ -z "$g" ] && ls -d "$d"*/.git >/dev/null 2>&1 && g=grupo
  printf 'F|%s|%s|%s\n' "${d%/}" "${t%.*}" "$g"
done
[ -d "$HOME/.codex/sessions" ] && printf 'C|%s\n' "$(find "$HOME/.codex/sessions" -type f -printf '%T@\n' 2>/dev/null | sort -n | tail -1 | cut -d. -f1)"
for p in $(pgrep -u "$(id -u)" -f '/home/agents/bin/buzon despertador'); do printf 'D|%s\n' "$p"; done
true
"""


def hace(segundos):
    """5 min, 3 h, 2 d: how long ago, short."""
    m = int(segundos) // 60
    return f"{m} min" if m < 60 else f"{m // 60} h" if m < 48 * 60 else f"{m // 1440} d"


def tabla(cabecera, filas, opcional=None):
    """A table under a header row, each column as wide as its longest cell. When it does
    not fit the screen (a phone), the column `opcional` (an index) is left out."""
    if not filas:
        return
    cols = list(range(len(cabecera)))
    def ancho(c):
        return max(len(str(f[c])) for f in [cabecera] + filas)
    if opcional is not None and 4 + sum(ancho(c) + 2 for c in cols) > shutil.get_terminal_size((100, 24)).columns:
        cols.remove(opcional)
    def linea(f):
        return "    " + "  ".join(str(f[c]).ljust(ancho(c)) for c in cols).rstrip()
    print(TENUE(linea(cabecera)))
    for f in filas:
        print(linea(f))


